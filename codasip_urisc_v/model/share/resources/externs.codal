#include "config.hcodal"
#include "common.hcodal"

#ifdef OPTION_ENABLE_CACHES

parameter bit[ADDR_W] CACHE_BASE = OPTION_CACHE_REGS_BASE;

parameter bit[32] ICACHE_SIZE = 0x4000;
parameter bit[32] ICACHE_NUMWAYS = 4;
parameter bit[32] ICACHE_LINESIZE = 32;

parameter bit[32] DCACHE_SIZE = 0x4000;
parameter bit[32] DCACHE_NUMWAYS = 4;
parameter bit[32] DCACHE_LINESIZE = 32;

cache cache_l1
{
    type = ALL;
    base = CACHE_BASE;
    program
    {
        size = ICACHE_SIZE;
        numways = ICACHE_NUMWAYS;
        linesize = ICACHE_LINESIZE;
        interface if_fetch_master
        {
            bits = { ADDR_W, DATA_W, LAU_W };
            endianness = LITTLE;
            type = AHB3_LITE:MASTER;
            flag = R;
        };

        interface if_fetch_slave
        {
            bits = { ADDR_W, FETCH_WIDTH, LAU_W };
            endianness = LITTLE;
            type = AHB3_LITE:SLAVE;
            flag = R;
        };
    };
    data
    {
        size = DCACHE_SIZE;
        numways = DCACHE_NUMWAYS;
        linesize = DCACHE_LINESIZE;
        interface if_ldst_master
        {
            bits = { ADDR_W, DATA_W, LAU_W };
            endianness = LITTLE;
            type = AHB3_LITE:MASTER;
            flag = RW;
        };
        interface if_ldst_slave
        {
            bits = { ADDR_W, DATA_W, LAU_W };
            endianness = LITTLE;
            type = AHB3_LITE:SLAVE;
            flag = RW;
        };
    };
};
connect cache_l1.if_fetch_master => if_fetch;
connect cache_l1.if_ldst_master => if_ldst;

#endif // ifdef OPTION_ENABLE_CACHES
