#include "config.hcodal"


// Main interfaces for memory operations
interface if_ldst
{
    type = AHB3_LITE:MASTER;
    bits = { ADDR_W, DATA_W, LAU_W };
    endianness = LITTLE;
    flag = RW;
};

interface if_fetch
{
    type = AHB3_LITE:MASTER;
    bits = { ADDR_W, DATA_W, LAU_W };
    endianness = LITTLE;
    flag = R;
    alignment = {
        data = {
#if defined(OPTION_ENABLE_CACHES)
            DATA_W
#else
            FETCH_WIDTH
#endif
        };
    };
};

#if defined(OPTION_OCD) && defined(OPTION_ENABLE_SYSBUS_ACCESS)
// Interface for system bus access - direct bus access from the debug module, as defined by RISC-V Debug spec.
interface if_sysbus
{
    type = AHB3_LITE:MASTER;
    bits = { ADDR_W, DATA_W, LAU_W };
    endianness = LITTLE;
    flag = RW;
    sysbus = true;
};
#endif


// Machine external interrupt - pic
port bit[1] p_meip { direction = IN; type = INTERRUPT; };
// Machine software interrupt - memory mapped register
port bit[1] p_msip { direction = IN; type = INTERRUPT; };
// Machine timer interrupt - timer
port bit[1] p_mtip { direction = IN; type = INTERRUPT; };

// Wait-for-interrupt port
port bit[1] p_wfi { direction = OUT; type = CONTROL; };

// NMI related ports
port bit[1] p_nmi { direction = IN; type = INTERRUPT; };
port bit[XLEN] p_nmi_mtval { direction = IN; type = DATA; };

// Boot address
port bit[XLEN] p_boot_addr { direction = IN; type = DATA; };
