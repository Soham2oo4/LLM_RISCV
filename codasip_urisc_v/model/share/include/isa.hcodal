#pragma once

#include "common.hcodal"

#define SEXT_XLEN(val) (int_<OPTION_XLEN>)(val)
#define ZEXT_XLEN(val) (uint_<OPTION_XLEN>)(val)
#define SEXT32(val)    (int32)(val)

#if OPTION_XLEN == 64
#define IF_OPTION_XLEN_64(...) __VA_ARGS__;
#else
#define IF_OPTION_XLEN_64(...)
#endif

#define DEF_REG(group, addr)                        \
    element reg##addr {                             \
        assembly { STRINGIZE(x##addr) };            \
        binary { addr:bit[5] };                     \
        return { addr };                            \
    };                                              \
    IF_OPTION_XLEN_64(set group##32 += reg##addr)   \
    set group += reg##addr;

#define DEF_REG_ALIAS(group, addr, syntax)                 \
    DEF_REG(group, addr)                                   \
    element reg##addr##_alias : compiler_alias(reg##addr), assembler_alias(reg##addr) { \
        assembly { syntax };                               \
        binary { addr:bit[5] };                            \
        return { addr };                                   \
    };                                                     \
    IF_OPTION_XLEN_64(set group##32 += reg##addr##_alias)  \
    set group += reg##addr##_alias;

#define DEF_REG_ALIAS2(group, addr, syntax1, syntax2)      \
    element reg##addr {                                    \
        assembly { syntax1 };                              \
        binary { addr:bit[5] };                            \
        return { addr };                                   \
    };                                                     \
    element reg##addr##_alias1 : compiler_alias(reg##addr), assembler_alias(reg##addr) { \
        assembly { STRINGIZE(x##addr) };                   \
        binary { addr:bit[5] };                            \
        return { addr };                                   \
    };                                                     \
    element reg##addr##_alias2 : compiler_alias(reg##addr), assembler_alias(reg##addr) { \
        assembly { syntax2 };                              \
        binary { addr:bit[5] };                            \
        return { addr };                                   \
    };                                                     \
    IF_OPTION_XLEN_64(set group##32 += reg##addr, reg##addr##_alias1, reg##addr##_alias2) \
    set group += reg##addr, reg##addr##_alias1, reg##addr##_alias2;

#define DEF_REG_ALIAS4(group, addr, syntax)  \
    element reg##addr {                      \
        assembly { syntax };                 \
        binary { addr:bit[5] };              \
        return { addr };                     \
    };                                       \
    element reg##addr##_alias : compiler_alias(reg##addr), assembler_alias(reg##addr) { \
        assembly { STRINGIZE(x##addr) };     \
        binary { addr:bit[5] };              \
        return { addr };                     \
    };                                       \
    IF_OPTION_XLEN_64(set group##32 += reg##addr, reg##addr##_alias) \
    set group += reg##addr, reg##addr##_alias;

#define DEF_REG_CSR(group, name, syntax, code)  \
    element csr_##name {                        \
        assembly { syntax };                    \
        binary { code };                        \
        return { code };                        \
    };                                          \
    set group += csr_##name;

#define DEF_OPC(name, syntax, code)  \
    element opc_##name {             \
        assembly { syntax };         \
        binary { code };             \
        return { code };             \
    };

#define DEF_OPC_GROUP(group, name, syntax, code)  \
    element opc_##name {                          \
        assembly { syntax };                      \
        binary { code };                          \
        return { code };                          \
    };                                            \
    set group += opc_##name;
