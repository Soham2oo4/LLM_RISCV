#pragma once

#include "config.hcodal"

// versions
#define CORE_VERSION_MAJOR 0
#define CORE_VERSION_MINOR 0
#define CORE_VERSION_PATCH 0

#if defined(OPTION_ENABLE_CACHES)
#define fetch_interface      cache_l1.if_fetch_slave
#define ldst_interface       cache_l1.if_ldst_slave
#else
#define fetch_interface      if_fetch
#define ldst_interface       if_ldst
#endif

#define INFO_LEVEL          2
#define WARNING_LEVEL       2
#define ERROR_LEVEL         2
#define DEBUG_LEVEL         2
#define TRACE_LEVEL         3
#define TRAP_INFO_LEVEL     4
#define SIGNATURE_LEVEL     5
#define PERF_LEVEL          6
#define CSR_LEVEL           7
#define PRINT_LVL_JTAG      30
#define PRINT_LVL_IFU       50
#define PRINT_LVL_IFB       51

#define EXIT_CODE_ERROR     128
#define ONES12 0xfff
#define EXIT_ON_WARNING
#define EXIT_ON_ERROR

#define dprintf(...) codasip_print(DEBUG_LEVEL, __VA_ARGS__)
#define traceprintf(...) codasip_print(TRACE_LEVEL, __VA_ARGS__)
#define iprintf(...) codasip_info(INFO_LEVEL, __VA_ARGS__)

#ifdef EXIT_ON_WARNING
    #define wprintf(...) codasip_fatal(EXIT_CODE_ERROR, __VA_ARGS__)
#else
    #define wprintf(...) codasip_warning(WARNING_LEVEL, __VA_ARGS__)
#endif

#ifdef EXIT_ON_ERROR
    #define eprintf(...) codasip_fatal(EXIT_CODE_ERROR, __VA_ARGS__)
#else
    #define eprintf(...) codasip_error(ERROR_LEVEL, __VA_ARGS__)
#endif

#define UNUSED(size) 0:bit[size]

