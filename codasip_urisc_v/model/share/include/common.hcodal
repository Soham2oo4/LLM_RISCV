// exceptions (trap) causes
enum causes_excpt : uint5
{
    // >= 12 - reserved
    MISALIGNED_FETCH = 0,
    FAULT_FETCH = 1,
    ILLEGAL_INST,
    BREAK,
    MISALIGNED_LOAD,
    FAULT_LOAD,
    MISALIGNED_STORE,
    FAULT_STORE,
    U_ECALL,
    M_ECALL = 11,
    NMI_BUS_ERROR = 24, // Buss error on fetch or ldst interface
    TGM_DM,             // Trigger fire: Enter Debug Mode.
    TGM_BREAK,          // Trigger fire: Raise a breakpoint exception.
};

// interrupt (trap) causes
enum causes_int : uint5
{
    M_INT_SW = 3,
    M_INT_TIMER = 7,
    M_INT_EXTERNAL = 11,
    M_INT_NMI = 16,
};

enum exception_interrupt
{
    EXCEPTION = 0,
    INTERRUPT
};

// event selectors for performance monitor
// event 0 is defined to mean no event
enum event_sel
{
    NO_EVENT = 0,
    TOTAL_FLUSH,
    CSR_FLUSH,
    EXC_FLUSH,
    INT_FLUSH,
    BRANCH_MISS,
    DATA_STALL,
    DIV_STALL,
    IFU_STALL,
    LSU_STALL,
};

