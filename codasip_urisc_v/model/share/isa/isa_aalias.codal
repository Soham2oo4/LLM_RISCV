element i_csrs_alias : assembler_alias(i_control_registers_reg)
{
    use reg_any as src;
    use op_csr as csr;
    assembly { "csrs" csr "," src };
    binary { csr src OPC_I_CSRRS[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_CSRRS[OPC_FRAG0] };
