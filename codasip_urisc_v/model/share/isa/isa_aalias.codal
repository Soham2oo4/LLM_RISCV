set isa += i_csrci_alias;

element i_csrci_alias2 : assembler_alias(i_control_registers_imm)
{
    use imm5 as imm;
    use op_csr as csr;
    assembly { "csrci" csr "," imm };
    binary { csr imm OPC_I_CSRRCI[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_CSRRCI[OPC_FRAG0] };
