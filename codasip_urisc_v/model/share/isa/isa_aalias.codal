element i_csrsi_alias : assembler_alias(i_control_registers_imm)
{
    use imm5 as imm;
    use op_csr as csr;
    assembly { "csrs" csr "," imm };
    binary { csr imm OPC_I_CSRRSI[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_CSRRSI[OPC_FRAG0] };
};

set isa += i_csrsi_alias;

element i_csrsi_alias2 : assembler_alias(i_control_registers_imm)
{
    use imm5 as imm;
    use op_csr as csr;
    assembly { "csrsi" csr "," imm };
    binary { csr imm OPC_I_CSRRSI[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_CSRRSI[OPC_FRAG0] };
};

set isa += i_csrsi_alias2;

/********************************************* SCALL **********************************************/

element i_ecall_alias : assembler_alias(i_ecall)
{
    assembly { "scall" };
    binary { OPC_SYS_ECALL[OPC_FRAG_SYS] 0:bit[RF_GPR_ADDR] OPC_SYS_ECALL[OPC_FRAG1]
        0:bit[RF_GPR_ADDR] OPC_SYS_ECALL[OPC_FRAG0] };
};

set isa += i_ecall_alias;

/******************************************** i_load **********************************************/
/*
 * lw a0, (a2) == lw a0, 0(a2)
 */
element i_load_alias : assembler_alias(i_load)
{
    use opc_loads as opc;
    use reg_any as dst, src;

    assembly { opc dst "," "(" src ")" };
    binary { 0:bit[IMM12_W] src opc[OPC_FRAG1] dst opc[OPC_FRAG0] };
};

set i_load_store += i_load_alias;

element i_store_alias : assembler_alias(i_store)
{
    use opc_stores as opc;
    use reg_any as src1, src2;
    assembly { opc src2 "," "(" src1 ")"  };
    binary { 0:bit[7] src2 src1 opc[OPC_FRAG1] 0:bit[5] opc[OPC_FRAG0] };
};

set i_load_store += i_store_alias;
