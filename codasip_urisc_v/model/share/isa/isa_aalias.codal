#include "isa.hcodal"
#include "opcodes.hcodal"

/****************************** Timers and counters ***********************************************/

// Number of clock cycles
DEF_OPC_GROUP(opc_timers_counters, rdcycle, "rdcycle", OPC_SYS_RDCYCLE)
// Real time
DEF_OPC_GROUP(opc_timers_counters, rdtime, "rdtime", OPC_SYS_RDTIME)
// Number of retired instructions
DEF_OPC_GROUP(opc_timers_counters, rdinstret, "rdinstret", OPC_SYS_RDINSTRET)
#if OPTION_XLEN == 32
// Number of clock cycles
DEF_OPC_GROUP(opc_timers_counters, rdcycleh, "rdcycleh", OPC_SYS_RDCYCLEH)
// Real time
DEF_OPC_GROUP(opc_timers_counters, rdtimeh, "rdtimeh", OPC_SYS_RDTIMEH)
// Number of retired instructions
DEF_OPC_GROUP(opc_timers_counters, rdinstreth, "rdinstreth", OPC_SYS_RDINSTRETH)
#endif

element i_timers_counters_aliases : assembler_alias(i_control_registers_reg)
{
    use opc_timers_counters as opc;
    use reg_any as dst;
    assembly { opc dst };
    binary { opc[OPC_FRAG_SYS] 0:bit[RF_GPR_ADDR] opc[OPC_FRAG1] dst opc[OPC_FRAG0] };
};

set i_system += i_timers_counters_aliases;

/****************************** Pseudo-instructions ***********************************************/

element i_tail_alias : assembler_alias(i_auipc, i_jalr)
{
    use rel_addr32_call_tail as addr;
    assembly { "tail" addr };
    binary {
        // 2nd instruction
        addr[11 .. 0] 6:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG0]
        // 1st instruction
        addr[31 .. 12] 6:bit[RF_GPR_ADDR] OPC_U_AUIPC[OPC_FRAG0]
    };
};

set i_comp += i_tail_alias;

element i_call_alias : assembler_alias(i_auipc, i_jalr)
{
    use rel_addr32_call_tail as addr;
    assembly { "call" addr };
    binary {
        // 2nd instruction
        addr[11 .. 0] 1:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG1] 1:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG0]
        // 1st instruction
        addr[31 .. 12] 1:bit[RF_GPR_ADDR] OPC_U_AUIPC[OPC_FRAG0]
    };
};

set i_comp += i_call_alias;

/**
 * la rd, symbol
 * --->
 * auipc rd, delta[31:12] +delta[11]
 * l{w|d}rd, rd, delta[11:0]
 */
element i_la_alias : assembler_alias(i_comp_2reg_imm, i_auipc)
{
    use rel_addr32 as addr;
    use reg_any as dst;
    assembly { "la" dst "," addr };
    binary {
        // 2nd instruction
        addr[11 .. 0] dst OPC_I_ADDI[OPC_FRAG1] dst OPC_I_ADDI[OPC_FRAG0]
        // 1st instruction
        addr[31 .. 12] dst OPC_U_AUIPC[OPC_FRAG0]
    };
};
#if OPTION_XLEN == 64
element i_li_aalias : assembler_alias(i_addiw, i_lui)
{
    use imm32_lui_addi as imm;
    use reg_any as dst;
    assembly { "li" dst "," imm };
    binary {
       // 2nd instruction
       imm[11..0] dst OPC_I_ADDIW[OPC_FRAG1] dst OPC_I_ADDIW[OPC_FRAG0]
       // 1st instruction
       imm[31..12] dst OPC_U_LUI // LUI
    };
};
#else
element i_li_aalias : assembler_alias(i_comp_2reg_imm, i_lui)
{
    use imm32_lui_addi as imm;
    use reg_any as dst;
    assembly { "li" dst "," imm };
    binary {
       // 2nd instruction
       imm[11..0] dst OPC_I_ADDI[OPC_FRAG1] dst OPC_I_ADDI[OPC_FRAG0]
       // 1st instruction
       imm[31..12] dst OPC_U_LUI // LUI
    };
};
#endif
set i_comp += i_la_alias, i_li_aalias;

/**
 * lla == la
 */
element i_lla_alias : assembler_alias(i_comp_2reg_imm, i_auipc)
{

    use rel_addr32 as addr;
    use reg_any as dst;
    assembly { "lla" dst "," addr };
    binary {
        // 2nd instruction
        addr[11 .. 0]  dst OPC_I_ADDI[OPC_FRAG1] dst OPC_I_ADDI[OPC_FRAG0] // ADDI
        // 1st instruction
        addr[31 .. 12] dst OPC_U_AUIPC[OPC_FRAG0] // AUIPC
    };
};

set i_comp += i_lla_alias;

#if OPTION_XLEN == 64

// Disable li64 alias for r28 (REG_UNUSED1) - reg28 is omitted in the list below.
set li64_reg : register_class(rf_gpr);
set li64_reg = reg1, reg2, reg3, reg4, reg5, reg6, reg7, reg8, reg9,
               reg10, reg11, reg12, reg13, reg14, reg15, reg16, reg17, reg18, reg19,
               reg20, reg21, reg22, reg23, reg24, reg25, reg26, reg27, reg29,
               reg30, reg31,
               reg1_alias, reg2_alias, reg3_alias, reg4_alias, reg5_alias, reg6_alias,
               reg7_alias, reg8_alias1, reg8_alias2, reg9_alias, reg10_alias, reg11_alias,
               reg12_alias, reg13_alias, reg14_alias, reg15_alias, reg16_alias, reg17_alias,
               reg18_alias, reg19_alias, reg20_alias, reg21_alias, reg22_alias, reg23_alias,
               reg24_alias, reg25_alias, reg26_alias, reg27_alias, reg29_alias, reg30_alias,
               reg31_alias;

element i_li64_aalias : assembler_alias(i_comp_3reg, i_comp_2reg_imm, i_lui, i_comp_2reg_imm_shift), ignore(RANDOMGEN)
{
    use imm64_li as imm;
    use li64_reg as dst;
    assembly { "li64" dst "," imm };
    binary {
       OPC_R_ADD[OPC_FRAG2] REG_UNUSED1:bit[5] dst OPC_R_ADD[OPC_FRAG1] dst OPC_R_ADD[OPC_FRAG0]
       imm[11..0] REG_UNUSED1:bit[5] OPC_I_ADDI[OPC_FRAG1] REG_UNUSED1:bit[5] OPC_I_ADDI[OPC_FRAG0]
       imm[31..12] REG_UNUSED1:bit[5] OPC_U_LUI
       OPC_SI_SLLI[OPC_FRAG_SHIFT] 32:bit[SHIFT_W] dst OPC_SI_SLLI[OPC_FRAG1] dst OPC_SI_SLLI[OPC_FRAG0]
       imm[43..32] dst OPC_I_ADDI[OPC_FRAG1] dst OPC_I_ADDI[OPC_FRAG0]
       imm[63..44] dst OPC_U_LUI
    };
};

set i_comp += i_li64_aalias;

#endif // OPTION_XLEN == 64

element i_load_global_alias : assembler_alias(i_load, i_auipc)
{
    use rel_addr32 as addr;
    use opc_loads as opc;
    use reg_any as dst;

    assembly { opc dst "," addr };
    binary {
        // 2nd instruction
        addr[11 .. 0] dst opc[OPC_FRAG1] dst opc[OPC_FRAG0] // load
        // 1st instruction
        addr[31 .. 12] dst OPC_U_AUIPC[OPC_FRAG0] // AUIPC
    };
};

set i_load_store += i_load_global_alias;

element i_store_global_alias : assembler_alias(i_store, i_auipc)
{
    use rel_addr32 as addr;
    use reg_any as src1, src2;
    use opc_stores as opc;
    assembly { opc src2 "," addr "," src1 };
    binary {
        // 2nd instruction
        addr[11 .. 5] src2 src1 opc[OPC_FRAG1] addr[4 .. 0] opc[OPC_FRAG0] // SW
        // 1st instruction
        addr[31 .. 12] src1 OPC_U_AUIPC[OPC_FRAG0] // AUIPC
    };
};

set i_load_store += i_store_global_alias;

/****************************** Memory Model ******************************************************/

element i_fence_alias : assembler_alias(i_fence)
{
    use opc_fence as opc;
    assembly { opc };
    binary { bit[FENCE_FM_W] 0xff:bit[8] 0:bit[RF_GPR_ADDR] opc[OPC_FRAG1] 0:bit[RF_GPR_ADDR]
        opc[OPC_FRAG0] };
};

set i_mem_model += i_fence_alias;

/************************ Integer Computational Register-Immediate Instructions *******************/

element i_ori_alias : assembler_alias(i_comp_2reg_imm)
{
    use reg_any as dst, src;
    use simm12;
    assembly { "ori" dst "," src "," simm12 };
    binary { simm12 src OPC_I_ORI[OPC_FRAG1] dst OPC_I_ORI[OPC_FRAG0] };
};

set i_comp += i_ori_alias;

element i_addi_alias : assembler_alias(i_comp_2reg_imm)
{
    use reg_any as dst, src;
    use simm12;
    assembly { "addi" dst "," src "," simm12 };
    binary { simm12 src OPC_I_ADDI[OPC_FRAG1] dst OPC_I_ADDI[OPC_FRAG0] };
};

set i_comp += i_addi_alias;

element i_andi_alias : assembler_alias(i_comp_2reg_imm)
{
    use reg_any as dst, src;
    use simm12;
    assembly { "andi" dst "," src "," simm12 };
    binary { simm12 src OPC_I_ANDI[OPC_FRAG1] dst OPC_I_ANDI[OPC_FRAG0] };
};

set i_comp += i_andi_alias;

element i_xori_alias : assembler_alias(i_comp_2reg_imm)
{
    use reg_any as dst, src;
    use simm12;
    assembly { "xori" dst "," src "," simm12 };
    binary { simm12 src OPC_I_XORI[OPC_FRAG1] dst OPC_I_XORI[OPC_FRAG0] };
};

set i_comp += i_xori_alias;

element i_comp_2reg_imm_shift_slli_alias : assembler_alias(i_comp_2reg_imm_shift)
{
    use reg_any as dst, src;
    use shift_imm as imm;
    assembly { "slli" dst "," src "," imm };
    binary { OPC_SI_SLLI[OPC_FRAG_SHIFT] imm src OPC_SI_SLLI[OPC_FRAG1] dst
        OPC_SI_SLLI[OPC_FRAG0] };
};

set i_comp += i_comp_2reg_imm_shift_slli_alias;

element i_comp_2reg_imm_shift_srai_alias : assembler_alias(i_comp_2reg_imm_shift)
{
    use reg_any as dst, src;
    use shift_imm as imm;
    assembly { "srai" dst "," src "," imm };
    binary { OPC_SI_SRAI[OPC_FRAG_SHIFT] imm src OPC_SI_SRAI[OPC_FRAG1] dst
        OPC_SI_SRAI[OPC_FRAG0] };
};

set i_comp += i_comp_2reg_imm_shift_srai_alias;

element i_comp_2reg_imm_shift_srli_alias : assembler_alias(i_comp_2reg_imm_shift)
{
    use reg_any as dst, src;
    use shift_imm as imm;
    assembly { "srli" dst "," src "," imm };
    binary { OPC_SI_SRLI[OPC_FRAG_SHIFT] imm src OPC_SI_SRLI[OPC_FRAG1] dst
        OPC_SI_SRLI[OPC_FRAG0] };
};

set i_comp += i_comp_2reg_imm_shift_srli_alias;

element i_move_alias : assembler_alias(i_mv_alias)
{
    use reg_any as dst, src;
    assembly { "move" dst "," src };
    binary { 0:bit[IMM12_W] src OPC_I_ADDI[OPC_FRAG1] dst OPC_I_ADDI[OPC_FRAG0] };
};

set  i_comp += i_move_alias;

element i_auipc_hi : assembler_alias(i_auipc)
{
    use opc_auipc as opc;
    use reg_any as dst;
    use imm20_reloc as imm;
    assembly { opc dst "," imm };
    binary { imm dst opc };
};

set i_comp += i_auipc_hi;

// Not
element i_not_alias : assembler_alias(i_comp_2reg_imm)
{
    use reg_any as dst, src;
    assembly { "not" dst "," src };
    binary { ONES12:bit[IMM12_W] src OPC_I_XORI[OPC_FRAG1] dst OPC_I_XORI[OPC_FRAG0] };
};

set i_comp += i_not_alias;

#if OPTION_XLEN == 64
element i_addiw_alias: assembler_alias(i_addiw)
{
    use reg32_any as dst, src;
    use simm12;
    assembly { "addiw" dst "," src "," simm12 };
    binary { simm12 src OPC_I_ADDIW[OPC_FRAG1] dst OPC_I_ADDIW[OPC_FRAG0] };
};

set i_comp +=  i_addiw_alias;

element i_comp_2reg_imm_shift32_sll_alias : assembler_alias(i_comp_2reg_imm_shift32)
{
    use reg32_any as dst, src;
    use shifthalf_imm as imm;
    assembly { "slliw" dst "," src "," imm };
    binary { OPC_SI_SLLIW[OPC_FRAG2] imm src OPC_SI_SLLIW[OPC_FRAG1] dst OPC_SI_SLLIW[OPC_FRAG0] };
};

set i_comp += i_comp_2reg_imm_shift32_sll_alias;

element i_comp_2reg_imm_shift32_srl_alias : assembler_alias(i_comp_2reg_imm_shift32)
