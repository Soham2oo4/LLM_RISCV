    assembly { "srliw" dst "," src "," imm };
    binary { OPC_SI_SRLIW[OPC_FRAG2] imm src OPC_SI_SRLIW[OPC_FRAG1] dst OPC_SI_SRLIW[OPC_FRAG0] };
};

set i_comp += i_comp_2reg_imm_shift32_srl_alias;

element i_comp_2reg_imm_shift32_sra_alias : assembler_alias(i_comp_2reg_imm_shift32)
{
    use reg32_any as dst, src;
    use shifthalf_imm as imm;
    assembly { "sraiw" dst "," src "," imm };
    binary { OPC_SI_SRAIW[OPC_FRAG2] imm src OPC_SI_SRAIW[OPC_FRAG1] dst OPC_SI_SRAIW[OPC_FRAG0] };
