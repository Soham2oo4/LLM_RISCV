/************************ Integer Computational Register-Register Instructions ********************/

element i_sltz_alias : assembler_alias(i_comp_3reg)
{
    use reg_any as dst, src1;
    assembly { "sltz" dst "," src1 };
    binary { OPC_R_SLT[OPC_FRAG2] 0:bit[5] src1 OPC_R_SLT[OPC_FRAG1] dst OPC_R_SLT[OPC_FRAG0] };
};

element i_sgtz_alias : assembler_alias(i_comp_3reg)
{
    use reg_any as dst, src2;
    assembly { "sgtz" dst "," src2 };
    binary { OPC_R_SLT[OPC_FRAG2] src2 0:bit[5] OPC_R_SLT[OPC_FRAG1] dst OPC_R_SLT[OPC_FRAG0] };
};

set isa += i_sltz_alias, i_sgtz_alias;

/****************************** Unconditional Jumps Aliases ***************************************/

element i_jalr_alias : assembler_alias(i_jalr)
{
    use reg_any as src;
    assembly { "jalr" src };
    binary { 0:bit[IMM12_W] src OPC_I_JALR[OPC_FRAG1] 1:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG0] };
};

element i_jlr_alias : assembler_alias(i_jalr)
{
    use reg_any as src;
    use simm12;
    assembly { "jr" src ","simm12 };
    binary { simm12 src OPC_I_JALR[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG0] };
};

set i_control += i_jlr_alias;

element i_ret_alias : assembler_alias(i_jalr)
{
    assembly { "ret" };
    binary { 0:bit[IMM12_W] REG_RA:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_JALR[OPC_FRAG0] };
};

set i_control += i_ret_alias, i_jalr_alias;

/****************************** Conditional Branches **********************************************/

element i_bltz_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src;
    use rel_addr12 as addr;
    assembly { "bltz" src "," addr };
    binary { addr[11..11] addr[9..4] 0:bit[RF_GPR_ADDR] src OPC_S_BLT[OPC_FRAG1]
        addr[3..0] addr[10..10] OPC_S_BLT[OPC_FRAG0] };
};

element i_bgtz_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src;
    use rel_addr12 as addr;
    assembly { "bgtz" src "," addr };
    binary { addr[11..11] addr[9..4] src 0:bit[RF_GPR_ADDR] OPC_S_BLT[OPC_FRAG1]
        addr[3..0] addr[10..10] OPC_S_BLT[OPC_FRAG0] };
};

element i_bnez_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src;
    use rel_addr12 as addr;
    assembly { "bnez" src "," addr };
    binary { addr[11..11] addr[9..4] 0:bit[RF_GPR_ADDR] src OPC_S_BNE[OPC_FRAG1]
        addr[3..0] addr[10..10] OPC_S_BNE[OPC_FRAG0] };
};

element i_beqz_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src;
    use rel_addr12 as addr;
    assembly { "beqz" src "," addr };
    binary { addr[11..11] addr[9..4] 0:bit[RF_GPR_ADDR] src OPC_S_BEQ[OPC_FRAG1]
        addr[3..0] addr[10..10] OPC_S_BEQ[OPC_FRAG0] };
};

element i_blez_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src;
    use rel_addr12 as addr;
    assembly { "blez" src "," addr };
    binary { addr[11..11] addr[9..4] src 0:bit[RF_GPR_ADDR] OPC_S_BGE[OPC_FRAG1]
        addr[3..0] addr[10..10] OPC_S_BGE[OPC_FRAG0] };
};

element i_bgez_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src;
    use rel_addr12 as addr;
    assembly { "bgez" src "," addr };
    binary { addr[11..11] addr[9..4] 0:bit[RF_GPR_ADDR] src OPC_S_BGE[OPC_FRAG1]
        addr[3..0] addr[10..10] OPC_S_BGE[OPC_FRAG0] };
};

element i_bgt_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src1, src2;
    use rel_addr12 as addr;
    assembly { "bgt" src1 "," src2 "," addr };
    binary { addr[11..11] addr[9..4] src1 src2 OPC_S_BLT[OPC_FRAG1] addr[3..0] addr[10..10]
        OPC_S_BLT[OPC_FRAG0] };
};

element i_bgtu_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src1, src2;
    use rel_addr12 as addr;
    assembly { "bgtu" src1 "," src2 "," addr };
    binary { addr[11..11] addr[9..4] src1 src2 OPC_S_BLTU[OPC_FRAG1] addr[3..0] addr[10..10]
        OPC_S_BLTU[OPC_FRAG0] };
};

element i_ble_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src1, src2;
    use rel_addr12 as addr;
    assembly { "ble" src1 "," src2 "," addr };
    binary { addr[11..11] addr[9..4] src1 src2 OPC_S_BGE[OPC_FRAG1] addr[3..0] addr[10..10]
        OPC_S_BGE[OPC_FRAG0] };
};

element i_bleu_alias : assembler_alias(i_control_conditional)
{
    use reg_any as src1, src2;
    use rel_addr12 as addr;
    assembly { "bleu" src1 "," src2 "," addr };
    binary { addr[11..11] addr[9..4] src1 src2 OPC_S_BGEU[OPC_FRAG1] addr[3..0] addr[10..10]
        OPC_S_BGEU[OPC_FRAG0] };
};

set i_control += i_beqz_alias, i_bgt_alias, i_bltz_alias, i_bnez_alias, i_blez_alias, i_bleu_alias,
    i_bgtu_alias, i_ble_alias, i_bgez_alias, i_bgtz_alias;

/****************************** Instructions to access CSRs ***************************************/
element i_csrr_alias : assembler_alias(i_control_registers_reg)
{
    use reg_any as dst;
    use op_csr as csr;
    assembly { "csrr" dst "," csr };
    binary { csr 0:bit[5] OPC_I_CSRRS[OPC_FRAG1] dst OPC_I_CSRRS[OPC_FRAG0] };
};

set isa += i_csrr_alias;

element i_csrw_alias : assembler_alias(i_control_registers_reg)
{
    use reg_any as src;
    use op_csr as csr;
    assembly { "csrw" csr "," src };
    binary { csr src OPC_I_CSRRW[OPC_FRAG1] 0:bit[RF_GPR_ADDR] OPC_I_CSRRW[OPC_FRAG0] };
};

set isa += i_csrw_alias;

