set reg32_any : operand(PROFILER);
set reg32_any = regs32, reg0, reg0_alias;
#endif

// Immediate control register address
element csr_imm : assembler_alias(csr_mstatus)
{
    unsigned attribute bit[IMM12_W] imm;
    assembly { imm };
    binary { imm };
};

set regs_csr : operand(COMPILER);
set op_csr : operand(PROFILER);
set op_csr = regs_csr, csr_imm;

