// 12bit Signed Immediate Value
element simm12_simple
{
    signed attribute bit[IMM12_W] simm;
    assembly { simm };
    binary { simm };
    return { simm };
};

// 12bit Signed Immediate Value with %lo Macro
element simm12_lo : assembler_alias(simm12_simple), compiler_alias(simm12_simple)
{
    // Using unsigned attribute because the value is interpreted by assembler and linker as unsigned.
    // Compiler has the semantics fixed in the return section.
    unsigned attribute bit[IMM12_W] val
    {
        encoding = val & 0xFFF;
        decoding = val;
    };

    assembly { "%lo" "(" val ")" };
    binary { val };
    semantics
    {
        codasip_compiler_unused();
    };
    return { (int12)val };
};

// 12bit Signed Immediate Value with %pcrel_lo Macro
element simm12_pcrel_lo : assembler_alias(simm12_simple), compiler_alias(simm12_simple)
{
    // Using unsigned attribute because the value is interpreted by assembler and linker as unsigned.
    // Compiler has the semantics fixed in the return section.
    unsigned attribute bit[IMM12_W] val
    {
        encoding = (val - current_address) & 0xFFF;
        decoding = val + current_address;
    };

    assembly { "%pcrel_lo" "(" val ")" };
    binary { val };
    semantics
    {
        codasip_compiler_unused();
    };
    return { (int12)val };
};

set simm12 = simm12_simple, simm12_lo, simm12_pcrel_lo;

// 12bit Signed Immediate Value with %lo Macro for store instructions S-type
element simm12_s_lo : assembler_alias(simm12_simple), compiler_alias(simm12_simple)
{
    // Using unsigned attribute because the value is interpreted by assembler and linker as unsigned.
    // Compiler has the semantics fixed in the return section.
    unsigned attribute bit[IMM12_W] val
    {
        encoding = val & 0xFFF;
        decoding = val;
    };

    assembly { "%lo" "(" val ")" };
    binary { val };
    semantics
    {
        codasip_compiler_unused();
    };
    return { (int12)val };
};

// 12bit Signed Immediate Value with %pcrel_lo Macro for store instructions S-type
element simm12_s_pcrel_lo : assembler_alias(simm12_simple), compiler_alias(simm12_simple)
{
    // Using unsigned attribute because the value is interpreted by assembler and linker as unsigned.
    // Compiler has the semantics fixed in the return section.
    unsigned attribute bit[IMM12_W] val
    {
        encoding = val & 0xFFF;
        decoding = val;
    };

    assembly { "%pcrel_lo" "(" val ")" };
    binary { val };
    semantics
    {
        codasip_compiler_unused();
    };
    return { (int12)val };
};

set simm12_s = simm12_simple, simm12_s_lo, simm12_s_pcrel_lo;

// Shift value
element shift_imm
{
    unsigned attribute bit[SHIFT_W] shift;
    assembly { shift };
    binary { shift };
    return { shift };
};

#if OPTION_XLEN == 64
    // Halfword shift value
    element shifthalf_imm
    {
        unsigned attribute bit[SHIFT_W - 1] shift;
        assembly { shift };
        binary { shift };
        return { shift };
    };
#endif

// 5bit Unsigned Immediate Value
element imm5
{
    unsigned attribute bit[IMM5_W] imm;
    assembly { imm };
    binary { imm };
    return { imm };
};

// 20bit Unsigned Immediate Value
element imm20_s12
{
    unsigned attribute bit[IMM20_W] imm;
    assembly { imm };
    binary { imm };
    return { (int32)imm << 12 };
};

// 20bit Unsigned Immediate Value
element imm20_hi
{
    unsigned attribute bit[IMM20_W] val
    {
        encoding = (val + 0x800) >> 12 & 0xFFFFF;
        decoding = val;
    };
    assembly { "%hi" "(" val ")" };
    binary { val };
    return { (int32)val << 12 };
};

// 20bit Unsigned Immediate Value
element imm20_pcrel_hi
{
    unsigned attribute bit[IMM20_W] val
    {
        encoding = (val - current_address + 0x800) >> 12 & 0xFFFFF;
        decoding = val + current_address;
    };
    assembly { "%pcrel_hi" "(" val ")" };
    binary { val };
    return { (int32)val << 12 };
};

set imm20_reloc = imm20_hi, imm20_pcrel_hi;

// 20bit Relative Address (shifted by 1 bit)
element rel_addr20
{
    signed attribute bit[IMM20_W] addr
    {
        label = true;
        encoding = (addr - current_address) >> 1;
        decoding = ((int21)addr << 1) + current_address;
    };
    // Address is relative to the address of the following instruction.
    assembly { addr };
    binary { addr };
    return { (XLEN_T)addr << 1 };
};

// 12bit Relative Address (shifted by 1 bit)
element rel_addr12
{
    signed attribute bit[IMM12_W] addr
    {
        label = true;
        encoding = (addr - current_address) >> 1;
        decoding = ((int13)addr << 1) + current_address;
    };
    // Address is relative to the address of the following instruction.
    assembly { addr };
    binary { addr };
    return { (XLEN_T)addr << 1 };
};

// 32bit Imm
element rel_addr32
{
    signed attribute bit[IMM32_W] addr
    {
        label = true;
        encoding = ((addr - current_address) & 0x800) ?
            ((addr - current_address) + 0x1000) & 0xFFFFFFFFu :
            (addr - current_address) & 0xFFFFFFFFu;
        decoding = ((addr + current_address) & 0x800) ?
            ((addr + current_address) + 0x1000) :
            (addr + current_address);
    };
    // Address is relative to the address of the following instruction.
    assembly { addr };
    binary { addr };
    return { addr };
};

// 32bit Imm for call and tail
element rel_addr32_call_tail_simple
{
    signed attribute bit[IMM32_W] addr
    {
        label = true;
        encoding = ((addr - current_address) & 0x800) ?
            ((addr - current_address) + 0x1000) & 0xFFFFFFFFu :
            (addr - current_address) & 0xFFFFFFFFu;
        decoding = ((addr + current_address) & 0x800) ?
            ((addr + current_address) + 0x1000) :
            (addr + current_address);
    };
    // Address is relative to the address of the following instruction.
    assembly { addr };
    binary { addr };
    return { addr };
};

set rel_addr32_call_tail = rel_addr32_call_tail_simple;

element imm32_lui_addi
{
    signed attribute bit[IMM32_W] addr
    {
        label = true;
        encoding = (addr & 0x800) ?
            (addr + 0x1000) & 0xFFFFFFFFu :
            addr & 0xFFFFFFFFu;
        decoding = (addr & 0x800) ?
            (addr - 0x1000) :
            addr;
    };
    // Address is relative to the address of the following instruction.
    assembly { addr };
    binary { addr };
};

#if OPTION_XLEN == 64

element imm64_li
{
    signed attribute bit[DATA_W] addr
    {
        label = true;
        // Prepare the immediate for i_li64_aalias alias
        encoding =
            (addr & 0x800ull) ?
            (
                (((addr & 0x80000000ull) && ((addr & 0xfffff000ull) != 0xfffff000ull)) || ((addr & 0xfffff000ull) == 0x7ffff000ull))  ?
                (
                    ((addr & 0x80000000000ull && ((addr & 0xFFF00000000ull) != 0xfff00000000ull)) || ((addr & 0xFFF00000000ull) == 0x7ff00000000ull))?
                        (addr + 0x1000ull + 0x100000000ull + 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull :
                        (addr + 0x1000ull + 0x100000000ull) & 0xFFFFFFFFFFFFFFFFull
                )
                :
                (
                    ((addr & 0x80000000000ull && ((addr & 0xffffffff000ull) != 0xffffffff000ull)) || ((addr & 0xffffffff000ull) == 0x7fffffff000ull)) ?
                        (addr + 0x1000ull + 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull :
                        (addr + 0x1000ull) & 0xFFFFFFFFFFFFFFFFull
                )

            )
            :
            (
                (addr & 0x80000000ull) ?
                (
                    ((addr & 0x80000000000ull && ((addr & 0xFFF00000000ull) != 0xfff00000000ull)) || ((addr & 0xFFF00000000ull) == 0x7ff00000000ull) )?
                        (addr + 0x100000000ull + 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull:
                        (addr + 0x100000000ull) & 0xFFFFFFFFFFFFFFFFull
                )
                :
                (
                    (addr & 0x80000000000ull) ?
                        (addr + 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull :
                        (addr) & 0xFFFFFFFFFFFFFFFFull
                )
            );
        // Decode the immediate from i_li64_aalias alias
        decoding =
            (addr & 0x800ull) ?
            (
                (((addr & 0x80000000ull) && ((addr & 0xfffff000ull) != 0xfffff000ull)) || ((addr & 0xfffff000ull) == 0x7ffff000ull))  ?
                (
                    ((addr & 0x80000000000ull && ((addr & 0xFFF00000000ull) != 0xfff00000000ull)) || ((addr & 0xFFF00000000ull) == 0x7ff00000000ull))?
                        (addr - 0x1000ull - 0x100000000ull - 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull :
                        (addr - 0x1000ull - 0x100000000ull) & 0xFFFFFFFFFFFFFFFFull
                )
                :
                (
                    ((addr & 0x80000000000ull && ((addr & 0xffffffff000ull) != 0xffffffff000ull)) || ((addr & 0xffffffff000ull) == 0x7fffffff000ull)) ?
                        (addr - 0x1000ull - 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull :
                        (addr - 0x1000ull) & 0xFFFFFFFFFFFFFFFFull
                )

            )
            :
            (
                (addr & 0x80000000ull) ?
                (
                    ((addr & 0x80000000000ull && ((addr & 0xFFF00000000ull) != 0xfff00000000ull)) || ((addr & 0xFFF00000000ull) == 0x7ff00000000ull) )?
                        (addr - 0x100000000ull - 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull:
                        (addr - 0x100000000ull) & 0xFFFFFFFFFFFFFFFFull
                )
                :
                (
                    (addr & 0x80000000000ull) ?
                        (addr - 0x100000000000ull) & 0xFFFFFFFFFFFFFFFFull :
                        (addr) & 0xFFFFFFFFFFFFFFFFull
                )
            );
    };
    // Address is relative to the address of the following instruction.
    assembly { addr };
    binary { addr };
};

#endif // OPTION_XLEN == 64

