#include "isa.hcodal"
#include "opcodes.hcodal"
#include "config.hcodal"

set regs : register_class(rf_gpr);
#if OPTION_XLEN == 64
set regs32 : register_class(rf_gpr32);
#endif

element reg0 : ignore(DOCUMENTATION)
{
    assembly { STRINGIZE(x0) };
    binary { 0:bit[5] };
    return { 0 };
};

element reg0_alias : assembler_alias(reg0)
{
    assembly { "zero" };
    binary { 0:bit[5] };
};

DEF_REG_ALIAS4(regs, 1, "ra")       // Return address
DEF_REG_ALIAS4(regs, 2, "sp")       // Stack pointer
DEF_REG_ALIAS(regs, 3, "gp")        // Global pointer
DEF_REG_ALIAS(regs, 4, "tp")        // Thread pointer
DEF_REG_ALIAS(regs, 5, "t0")        // Temporary 0
DEF_REG_ALIAS(regs, 6, "t1")        // Temporary 1
DEF_REG_ALIAS(regs, 7, "t2")        // Temporary 2
DEF_REG_ALIAS2(regs, 8, "fp", "s0") // Frame pointer / saved register 0
DEF_REG_ALIAS(regs, 9, "s1")        // Saved register 1
DEF_REG_ALIAS(regs, 10, "a0")       // Function argument 0 / return value 0
DEF_REG_ALIAS(regs, 11, "a1")       // Function argument 1 / return value 1
DEF_REG_ALIAS(regs, 12, "a2")       // Function argument 2
DEF_REG_ALIAS(regs, 13, "a3")       // Function argument 3
DEF_REG_ALIAS(regs, 14, "a4")       // Function argument 4
