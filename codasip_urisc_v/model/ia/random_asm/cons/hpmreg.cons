        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##10##__VA_ARGS__); \
        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##11##__VA_ARGS__); \
        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##12##__VA_ARGS__); \
        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##13##__VA_ARGS__); \
