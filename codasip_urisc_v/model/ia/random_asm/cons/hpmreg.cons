// suppress generation of all possible elements (complete set) of all HPM registers identified by the given register name
// repl_pfx - prefix name
// repl_reg - register name [mhpmcounter(h), mhpmevent, hpmcounter(h)]
// ... - (variadic argument) for suffix 'h' when length = 32
#define OVERRIDE_I_CONTROL_REGISTERS_ALL_HPMREG(repl_pfx, repl_reg, ...) \
        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##3##__VA_ARGS__); \
        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##4##__VA_ARGS__); \
