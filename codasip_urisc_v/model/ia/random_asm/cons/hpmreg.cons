        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##17##__VA_ARGS__), \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##18##__VA_ARGS__), \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##19##__VA_ARGS__), \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##20##__VA_ARGS__), \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##21##__VA_ARGS__), \
