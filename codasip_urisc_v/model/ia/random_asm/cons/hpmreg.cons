#ifndef _HPMREG_
#define _HPMREG_

// create element names for all possible instructions (complete set) of all HPM registers for the given register name
// repl_pfx - prefix name
// repl_reg - register name [mhpmcounter(h), mhpmevent, hpmcounter(h)]
// ... - (variadic argument) for suffix 'h' when length = 32
#define I_CONTROL_REGISTERS_ALL_HPMREG(repl_pfx, repl_reg, ...) \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##3##__VA_ARGS__), \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##4##__VA_ARGS__), \
        I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##5##__VA_ARGS__), \
