        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##30##__VA_ARGS__); \
        OVERRIDE_I_CONTROL_REGISTERS_ALL(repl_pfx, repl_reg##31##__VA_ARGS__)

// concatenate the token code into string of next calling macro name to execute switch case
#define I_CONTROL_REGISTERS_HOW_HPMREG(x) I_CONTROL_REGISTERS_HOW_HPMREG_(x)
#define I_CONTROL_REGISTERS_HOW_HPMREG_(x) I_CONTROL_REGISTERS_HOW_HPMREG_##x

// Perform the appropriate procedure (of complete set) based on the call.
// When override Write (how=2) MUST also follow changing instructions use immediate operand ONLY ZERO value!
// When override Read-Only (how=3) MUST also follow changing instructions use immediate operand NONE ZERO value!
// repl_pfx - prefix name
// repl_reg - register name [mhpmcounter(h), mhpmevent, hpmcounter(h)]
// ... - (variadic argument) for suffix 'h' when length = 32
#define I_CONTROL_REGISTERS_HOW_HPMREG_0(repl_pfx, repl_reg, ...) I_CONTROL_REGISTERS_ALL_HPMREG(repl_pfx, repl_reg, __VA_ARGS__)
#define I_CONTROL_REGISTERS_HOW_HPMREG_1(repl_pfx, repl_reg, ...) I_CONTROL_REGISTERS_READ_HPMREG(repl_pfx, repl_reg, __VA_ARGS__)
#define I_CONTROL_REGISTERS_HOW_HPMREG_2(repl_pfx, repl_reg, ...) I_CONTROL_REGISTERS_WRITE_HPMREG(repl_pfx, repl_reg, __VA_ARGS__)
#define I_CONTROL_REGISTERS_HOW_HPMREG_3(repl_pfx, repl_reg, ...) I_CONTROL_REGISTERS_READ_ONLY_HPMREG(repl_pfx, repl_reg, __VA_ARGS__)
#define I_CONTROL_REGISTERS_HOW_HPMREG_4(repl_pfx, repl_reg, ...) I_CONTROL_REGISTERS_WRITE_ONLY_HPMREG(repl_pfx, repl_reg, __VA_ARGS__)
#define I_CONTROL_REGISTERS_HOW_HPMREG_5(repl_pfx, repl_reg, ...) I_CONTROL_REGISTERS_WRITE_SPEC_HPMREG(repl_pfx, repl_reg, __VA_ARGS__)

#endif //_HPMREG_
