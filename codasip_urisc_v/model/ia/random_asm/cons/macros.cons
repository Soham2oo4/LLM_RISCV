#ifndef _MACROS_
#define _MACROS_

//----------------------------------------------------------------------------------------------------------

// Adjust the range of the data memory section depending on the options being processed.
// Counted size by randomgen and option offset ( CODASIP_PROGRAM_SIZE + OPTION_BOOT_START )
// could not be used until all elements (e.g. program_start) will have correctly constrainted size.
#define ADDR_SPACE ( 0x00010000 )..( OPTION_MEMORY_SIZE - 1 )

// correctly obtained min and max addresses of data memory
#define ADDR_SPACE_LOAD_MIN ( 0x00010000 )
#define ADDR_SPACE_LOAD_MAX ( OPTION_MEMORY_SIZE - 1 )
#define ADDR_SPACE_STORE_MIN ( 0x00010000 )
#define ADDR_SPACE_STORE_MAX ( OPTION_MEMORY_SIZE - 1 )

//----------------------------------------------------------------------------------------------------------

// difference data width, instructions for loading, MSB bit shift location to indicate the interrupt
#if OPTION_XLEN == 64
#define REG_DATA_TYPE uint64
#define E_LI_OPRD uimm_64_0
#define E_LI_INSTR load_imm64__regs__regs__regs__regs__regs__regs__regs__
#define E_LI_ALIAS li64
#define MSB_CAUSE_IRQ 63
#else
#define REG_DATA_TYPE uint32
#define E_LI_OPRD uimm_32_0
#define E_LI_INSTR load_imm32__regs__regs__regs__
#define E_LI_ALIAS li
#define MSB_CAUSE_IRQ 31
#endif

// macro used for handling loading of immediates on RV32 and RV64
#if OPTION_XLEN == 64
#define LOAD_IMMEDIATE(reg_src, immediate) load_imm64__regs__regs__regs__regs__regs__regs__regs__(regs_dst_0 = reg_src, uimm_64_0 = immediate)
#else
#define LOAD_IMMEDIATE(reg_src, immediate) load_imm32__regs__regs__regs__(regs_dst_0 = reg_src, uimm_32_0 = immediate)
#endif

//----------------------------------------------------------------------------------------------------------

// random value inside load address space with alignment
#if defined(OPTION_ENABLE_CACHES)
#if OPTION_XLEN == 64
#define ACCURATE_ADDR uimm_64_divisible_8_load_range_0_0
#else
#define ACCURATE_ADDR uimm_32_divisible_4_load_range_0_0
#endif
#endif

//----------------------------------------------------------------------------------------------------------

// auxiliary register rf_gpr[a]=x10=a0 used for intermediate working (not tracking by consistency checker)
#define TEMP_REGISTER a0

// variant limits register count, obtained from /model/ia/compiler/user_semantics.sem
#define MAX_REGISTER x31
#define APPLY_REGISTER x28

//----------------------------------------------------------------------------------------------------------

// cover complicated conditions by one symbol
#if (defined(PRV_MODE_CHANGE) || defined(false) || defined(false))
#define ENVIRON_CALL
#endif

// implemented register that capture instruction bits on illegal instruction

// implemented available virtual-memory schemes

// expectation to control address translation and protection

//----------------------------------------------------------------------------------------------------------

// put NOPs after required CSR registers instruction
#define GENERATE_AFTER_NOP
#define GENERATE_AFTER_NOP_COMP

// append defined number NOPs operation
#define MIE_NOP_NUM      3
#define MSTATUS_NOP_NUM  3

#define MPICFLAG_NOP_NUM 3
#define MPICMASK_NOP_NUM 3
// find out just first PICs register which it's holding non-zero value
#define MPICFLAG_FIND_FIRST

// for different core that should be required individual NOPs operation
#define NOP_AFTER_PROGRAM 64
#ifndef NOP_AFTER_PROGRAM
#define NOP_AFTER_PROGRAM 0
#endif
#define NOP_AFTER_SYSCALL 4

//----------------------------------------------------------------------------------------------------------

#define STRINGIFY(x) #x
#define TO_STRING(x) STRINGIFY(x)

//----------------------------------------------------------------------------------------------------------

// proceed by label when equal zero (reg == 0)
// gpr_reg - rf_gpr register
// str_label - label address to continue
#define MACRO_BEQZ(gpr_reg, str_label) \
        "    beqz " TO_STRING(gpr_reg) ", " str_label "\n"

// proceed by label when not equal zero (reg != 0)
// gpr_reg - rf_gpr register
// str_label - label address to continue
#define MACRO_BNEZ(gpr_reg, str_label) \
        "    bnez " TO_STRING(gpr_reg) ", " str_label "\n"

// proceed by label when less than zero (reg < 0)
// gpr_reg - rf_gpr register
// str_label - label address to continue
#define MACRO_BLTZ(gpr_reg, str_label) \
        "    bltz " TO_STRING(gpr_reg) ", " str_label "\n"

// proceed by label when less than or equal zero (reg <= 0)
// gpr_reg - rf_gpr register
// str_label - label address to continue
#define MACRO_BLEZ(gpr_reg, str_label) \
        "    blez " TO_STRING(gpr_reg) ", " str_label "\n"

// proceed by label when great than zero (reg > 0)
// gpr_reg - rf_gpr register
// str_label - label address to continue
#define MACRO_BGTZ(gpr_reg, str_label) \
        "    bgtz " TO_STRING(gpr_reg) ", " str_label "\n"

// proceed by label when great than or equal zero (reg >= 0)
// gpr_reg - rf_gpr register
// str_label - label address to continue
#define MACRO_BGEZ(gpr_reg, str_label) \
        "    bgez " TO_STRING(gpr_reg) ", " str_label "\n"

//----------------------------------------------------------------------------------------------------------

// proceed by label when equal (reg_1 == reg_2)
// gpr_reg_1 - rf_gpr register
// gpr_reg_2 - rf_gpr register
// str_label - label address to continue
#define MACRO_BEQ(gpr_reg_1, gpr_reg_2, str_label) \
        "    beq " TO_STRING(gpr_reg_1) ", " TO_STRING(gpr_reg_2) ", " str_label "\n"

// proceed by label when not equal (reg_1 != reg_2)
// gpr_reg_1 - rf_gpr register
// gpr_reg_2 - rf_gpr register
// str_label - label address to continue
#define MACRO_BNE(gpr_reg_1, gpr_reg_2, str_label) \
        "    bne " TO_STRING(gpr_reg_1) ", " TO_STRING(gpr_reg_2) ", " str_label "\n"

// proceed by label when less than (reg_1 < reg_2)
// gpr_reg_1 - rf_gpr register
// gpr_reg_2 - rf_gpr register
// str_label - label address to continue
#define MACRO_BLT(gpr_reg_1, gpr_reg_2, str_label) \
        "    blt " TO_STRING(gpr_reg_1) ", " TO_STRING(gpr_reg_2) ", " str_label "\n"

// proceed by label when less than or equal (reg_1 <= reg_2)
// gpr_reg_1 - rf_gpr register
// gpr_reg_2 - rf_gpr register
// str_label - label address to continue
#define MACRO_BLE(gpr_reg_1, gpr_reg_2, str_label) \
        "    ble " TO_STRING(gpr_reg_1) ", " TO_STRING(gpr_reg_2) ", " str_label "\n"

// proceed by label when great than (reg_1 > reg_2)
// gpr_reg_1 - rf_gpr register
// gpr_reg_2 - rf_gpr register
// str_label - label address to continue
#define MACRO_BGT(gpr_reg_1, gpr_reg_2, str_label) \
        "    bgt " TO_STRING(gpr_reg_1) ", " TO_STRING(gpr_reg_2) ", " str_label "\n"

// proceed by label when great than or equal (reg_1 >= reg_2)
// gpr_reg_1 - rf_gpr register
// gpr_reg_2 - rf_gpr register
// str_label - label address to continue
#define MACRO_BGE(gpr_reg_1, gpr_reg_2, str_label) \
        "    bge " TO_STRING(gpr_reg_1) ", " TO_STRING(gpr_reg_2) ", " str_label "\n"

//----------------------------------------------------------------------------------------------------------

// read into rf_gpr register from CSR register
// gpr_reg - destination rf_gpr register
// csr_reg - source CSR register
// ... - (variadic argument) continue string padding and comment
#define MACRO_READ_CSR(gpr_reg, csr_reg, ...) \
        "    csrr " TO_STRING(gpr_reg) ", " TO_STRING(csr_reg) __VA_ARGS__ "\n"

// write from rf_gpr register into CSR register
// csr_reg - destination CSR register
// gpr_reg - source rf_gpr register
// ... - (variadic argument) continue string padding and comment
#define MACRO_WRITE_CSR(csr_reg, gpr_reg, ...) \
        "    csrw " TO_STRING(csr_reg) ", " TO_STRING(gpr_reg) __VA_ARGS__ "\n"

// write immediate into CSR register
// csr_reg - destination CSR register
// imm_val - immediate value
// ... - (variadic argument) continue string padding and comment
#define MACRO_WRITE_CSR_IMM(csr_reg, imm_val, ...) \
        "    csrwi " TO_STRING(csr_reg) ", " TO_STRING(imm_val) __VA_ARGS__ "\n"

// clear CSR register value apply from rf_gpr register
// csr_reg - destination CSR register
// gpr_reg - source rf_gpr register
// ... - (variadic argument) continue string padding and comment
#define MACRO_CLEAR_CSR(csr_reg, gpr_reg, ...) \
        "    csrc " TO_STRING(csr_reg) ", " TO_STRING(gpr_reg) __VA_ARGS__ "\n"

// clear CSR register immediate value
// csr_reg - destination CSR register
// imm_val - immediate value
// ... - (variadic argument) continue string padding and comment
#define MACRO_CLEAR_CSR_IMM(csr_reg, imm_val, ...) \
        "    csrci " TO_STRING(csr_reg) ", " TO_STRING(imm_val) __VA_ARGS__ "\n"

// set CSR register value apply from rf_gpr register
// csr_reg - destination CSR register
// gpr_reg - source rf_gpr register
// ... - (variadic argument) continue string padding and comment
#define MACRO_SET_CSR(csr_reg, gpr_reg, ...) \
        "    csrs " TO_STRING(csr_reg) ", " TO_STRING(gpr_reg) __VA_ARGS__ "\n"

// set CSR register immediate value
// csr_reg - destination CSR register
// imm_val - immediate value
// ... - (variadic argument) continue string padding and comment
#define MACRO_SET_CSR_IMM(csr_reg, imm_val, ...) \
        "    csrsi " TO_STRING(csr_reg) ", " TO_STRING(imm_val) __VA_ARGS__ "\n"

//----------------------------------------------------------------------------------------------------------

// operation 'ADD'
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src_1 - source rf_gpr register
// gpr_reg_src_2 - source rf_gpr register
// ... - (variadic argument) continue string padding and comment
#define MACRO_ADD(gpr_reg_dst, gpr_reg_src_1, gpr_reg_src_2, ...) \
        "    add " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src_1) ", " TO_STRING(gpr_reg_src_2) __VA_ARGS__ "\n"

// operation 'ADD' immediate
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src - source rf_gpr register
// imm_val - immediate value
// ... - (variadic argument) continue string padding and comment
#define MACRO_ADDI(gpr_reg_dst, gpr_reg_src, imm_val, ...) \
        "    addi " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src) ", " TO_STRING(imm_val) __VA_ARGS__ "\n"

// operation 'ADD' immediate using variable
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src - source rf_gpr register
// imm_var - properly randomized variable
// ... - (variadic argument) continue string padding and comment
#define MACRO_ADDI_VAR(gpr_reg_dst, gpr_reg_src, imm_var, ...) \
        "    addi " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src) ", " imm_var __VA_ARGS__ "\n"

//----------------------------------------------------------------------------------------------------------

// operation 'AND'
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src_1 - source rf_gpr register
// gpr_reg_src_2 - source rf_gpr register
// ... - (variadic argument) continue string padding and comment
#define MACRO_AND(gpr_reg_dst, gpr_reg_src_1, gpr_reg_src_2, ...) \
        "    and " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src_1) ", " TO_STRING(gpr_reg_src_2) __VA_ARGS__ "\n"

// operation 'AND' immediate
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src - source rf_gpr register
// imm_val - immediate value
// ... - (variadic argument) continue string padding and comment
#define MACRO_ANDI(gpr_reg_dst, gpr_reg_src, imm_val, ...) \
        "    andi " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src) ", " TO_STRING(imm_val) __VA_ARGS__ "\n"

// operation 'AND' immediate using variable
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src - source rf_gpr register
// imm_var - properly randomized variable
// ... - (variadic argument) continue string padding and comment
#define MACRO_ANDI_VAR(gpr_reg_dst, gpr_reg_src, imm_var, ...) \
        "    andi " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src) ", " imm_var __VA_ARGS__ "\n"

//----------------------------------------------------------------------------------------------------------

// operation 'XOR'
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src_1 - source rf_gpr register
// gpr_reg_src_2 - source rf_gpr register
// ... - (variadic argument) continue string padding and comment
#define MACRO_XOR(gpr_reg_dst, gpr_reg_src_1, gpr_reg_src_2, ...) \
        "    xor " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src_1) ", " TO_STRING(gpr_reg_src_2) __VA_ARGS__ "\n"

// operation 'XOR' immediate
// gpr_reg_dst - destination rf_gpr register
// gpr_reg_src - source rf_gpr register
// imm_val - immediate value
// ... - (variadic argument) continue string padding and comment
#define MACRO_XORI(gpr_reg_dst, gpr_reg_src, imm_val, ...) \
        "    xori " TO_STRING(gpr_reg_dst) ", " TO_STRING(gpr_reg_src) ", " TO_STRING(imm_val) __VA_ARGS__ "\n"

// operation 'XOR' immediate using variable
