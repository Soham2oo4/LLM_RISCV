#ifndef _MTVAL_
#define _MTVAL_

// mtval [Machine Trap Value Register]: written with exception-specific information (providing faulting instruction or efective address) to assist in handling the trap

//----------------------------------------------------------------------------------------------------------

#if defined(OVERRIDE_EXPLICIT_MTVAL)
#if OVERRIDE_EXPLICIT_MTVAL != 0xFF
#define OVERRIDE_MTVAL_HOW OVERRIDE_EXPLICIT_MTVAL
#endif
#endif

//----------------------------------------------------------------------------------------------------------
#if defined(OVERRIDE_MTVAL_HOW)
//----------------------------------------------------------------------------------------------------------

set program_instruction
{
    constraints
    {
        weights
        {
            OVERRIDE_I_CONTROL_REGISTERS_HOW(OVERRIDE_MTVAL_HOW)(, mtval);
        };
    };
};

#if OVERRIDE_MTVAL_HOW == 2
CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_ONLYZERO(mtval);
#endif

#if OVERRIDE_MTVAL_HOW == 3
CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_NONEZERO(mtval);
#endif

//----------------------------------------------------------------------------------------------------------
#endif //defined(OVERRIDE_MTVAL_HOW)
//----------------------------------------------------------------------------------------------------------

#endif //_MTVAL_
