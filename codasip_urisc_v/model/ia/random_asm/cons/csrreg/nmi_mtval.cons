#ifndef _NMI_MTVAL_
#define _NMI_MTVAL_

// nmi_mtval [Non-Maskable Interrupts Machine Trap Value]: specific information (read from port) to assist in handling the trap in case of NMI
// platform specific machine read-only register (MRO)

#if defined(OVERRIDE_EXPLICIT_NMI_MTVAL)
#if OVERRIDE_EXPLICIT_NMI_MTVAL != 0xFF
#define OVERRIDE_NMI_MTVAL_HOW OVERRIDE_EXPLICIT_NMI_MTVAL
#endif
#endif

//----------------------------------------------------------------------------------------------------------
#if defined(OVERRIDE_NMI_MTVAL_HOW)
//----------------------------------------------------------------------------------------------------------

set program_instruction
{
    constraints
    {
        weights
        {
            OVERRIDE_I_CONTROL_REGISTERS_HOW(OVERRIDE_NMI_MTVAL_HOW)(, nmi_mtval);
        };
    };
};

#if OVERRIDE_NMI_MTVAL_HOW == 2
CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_ONLYZERO(nmi_mtval);
#endif

#if OVERRIDE_NMI_MTVAL_HOW == 3
CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_NONEZERO(nmi_mtval);
#endif

//----------------------------------------------------------------------------------------------------------
#endif //defined(OVERRIDE_NMI_MTVAL_HOW)
//----------------------------------------------------------------------------------------------------------

#endif //_NMI_MTVAL_
