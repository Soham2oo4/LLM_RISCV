#ifndef _MHPMEVENT_
#define _MHPMEVENT_

// mhpmevent [Machine Performance Event Register]: control which event causes the corresponding counter to increment

#if defined(OVERRIDE_EXPLICIT_MHPMEVENT)
#if OVERRIDE_EXPLICIT_MHPMEVENT != 0xFF
#define OVERRIDE_MHPMEVENT_HOW OVERRIDE_EXPLICIT_MHPMEVENT
#else
#define UNTOUCHED_MHPMEVENT_VALUE
#endif
#endif

//----------------------------------------------------------------------------------------------------------
#if !defined(UNTOUCHED_MHPMEVENT_VALUE)
//----------------------------------------------------------------------------------------------------------

// meaning: decrease the weights for all required registers selected during randomization
// 1. create long group of all instructions
//    in principle, reduce the probability for group will be the same as one instruction
// 2. add each created set to the root of program_instruction tree
//    included instructions in set will be considered as the second level by the randomgen
// 3. always update root program_instruction
//    turning-off all corresponding pre-generated elements on the first level

//----------------------------------------------------------------------------------------------------------
#if defined(OVERRIDE_MHPMEVENT_HOW)
//----------------------------------------------------------------------------------------------------------
//----------------------------------------------------------------------------------------------------------
#if (OVERRIDE_MHPMEVENT_HOW != 0)
//----------------------------------------------------------------------------------------------------------

set i_control_registers__mhpmeventX__ = I_CONTROL_REGISTERS_HOW_HPMREG(OVERRIDE_MHPMEVENT_HOW)(, mhpmevent);
set program_instruction += i_control_registers__mhpmeventX__;

//----------------------------------------------------------------------------------------------------------
#endif //(OVERRIDE_MHPMEVENT_HOW != 0)
//----------------------------------------------------------------------------------------------------------
//----------------------------------------------------------------------------------------------------------
#else
//----------------------------------------------------------------------------------------------------------

set i_control_registers__mhpmeventX__ = I_CONTROL_REGISTERS_ALL_HPMREG(, mhpmevent);
set program_instruction += i_control_registers__mhpmeventX__;

//----------------------------------------------------------------------------------------------------------
#endif //defined(OVERRIDE_MHPMEVENT_HOW)
//----------------------------------------------------------------------------------------------------------

set program_instruction
{
    constraints
    {
        weights
        {
            OVERRIDE_I_CONTROL_REGISTERS_ALL_HPMREG(, mhpmevent);
        };
    };
};
//----------------------------------------------------------------------------------------------------------
#endif //defined(UNTOUCHED_MHPMEVENT_VALUE)
//----------------------------------------------------------------------------------------------------------

#endif //_MHPMEVENT_
