set program_instruction +=
    wrapped_i_comp_3reg__opc_mul__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_mulh__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_mulhu__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_mulhsu__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_div__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_rem__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_divu__regs__regs__regs__,
    wrapped_i_comp_3reg__opc_remu__regs__regs__regs__
{
    constraints
    {
        weights
        {
            wrapped_i_comp_3reg__opc_mul__regs__regs__regs__    = 30;
            wrapped_i_comp_3reg__opc_mulh__regs__regs__regs__   = 30;
            wrapped_i_comp_3reg__opc_mulhu__regs__regs__regs__  = 30;
            wrapped_i_comp_3reg__opc_mulhsu__regs__regs__regs__ = 30;
            wrapped_i_comp_3reg__opc_div__regs__regs__regs__    = 30;
            wrapped_i_comp_3reg__opc_rem__regs__regs__regs__    = 30;
            wrapped_i_comp_3reg__opc_divu__regs__regs__regs__   = 30;
            wrapped_i_comp_3reg__opc_remu__regs__regs__regs__   = 30;
        };
    };
};

#endif /* (OPTION_XLEN == 32) */
#endif /* defined(OPTION_EXTENSION_M) */
#endif /* _EXT_M_WEIGHTS_ */

