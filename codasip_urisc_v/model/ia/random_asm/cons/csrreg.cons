//----------------------------------------------------------------------------------------------------------

// substitute command for macro below
// illegal register used only in instruction load_imm64
#if OPTION_XLEN == 64
#define DEAL_WITH_ILLEGAL \
    constraints \
    { \
        illegal = { TO_STRING(APPLY_REGISTER) }; \
    };
#else
#define DEAL_WITH_ILLEGAL
#endif

// create scenario statement which load randomized value into gpr register, after then use it for element instruction
// repl_pfx - prefix name of the current element
// repl_scx - prefix name of wrapped scenario
// repl_typ - type of instruction [reg]
// repl_csr - CSR instruction [csrrc | csrrs | csrrw]
// repl_dst - destination operand [reg0 | regs]
// repl_reg - register name
// repl_src - source operand [regs]
// repl_itm - intermediate hold [regs_unknown_0, regs_unknown_1]
// repl_var - variable name
#define CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS(repl_pfx, repl_scx, repl_typ, repl_csr, repl_dst, repl_reg, repl_src, repl_itm, repl_var) \
scenario repl_scx##i_control_registers_##repl_typ##__opc_##repl_csr##__##repl_dst##__csr_##repl_reg##__##repl_src##__ \
{ \
    instructions \
    { \
        load_value_comment(E_LI_OPRD = repl_var); \
        E_LI_INSTR(regs_dst_0 = repl_itm, E_LI_OPRD = repl_var); \
        I_CONTROL_REGISTERS(repl_pfx, repl_typ, repl_csr, repl_dst, repl_reg, repl_src)(repl_itm = repl_itm); \
    }; \
    DEAL_WITH_ILLEGAL \
}

// create scenarios use randomized value for element with registers as source
// repl_pfx - prefix name of the current element
// repl_scx - prefix name of wrapped scenario
// repl_csr - CSR instruction [csrrc | csrrs | csrrw]
// repl_reg - register name
// repl_var - variable name
#define CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS_REGS(repl_pfx, repl_scx, repl_csr, repl_reg, repl_var) \
        CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS(repl_pfx, repl_scx, reg, repl_csr, regs, repl_reg, regs, regs_unknown_1, repl_var); \
        CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS(repl_pfx, repl_scx, reg, repl_csr, reg0, repl_reg, regs, regs_unknown_0, repl_var)

// create scenarios use randomized value for element with registers as source (exactly specified instructions)
// repl_pfx - prefix name of the current element
// repl_scx - prefix name of wrapped scenario
// repl_reg - register name
// repl_var - variable name
#define CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS_REGS_FIX(repl_pfx, repl_scx, repl_reg, repl_var) \
        CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS_REGS(repl_pfx, repl_scx, csrrc, repl_reg, repl_var); \
        CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS_REGS(repl_pfx, repl_scx, csrrs, repl_reg, repl_var); \
        CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS_REGS(repl_pfx, repl_scx, csrrw, repl_reg, repl_var)

// create one scenario use randomized value for element with x0 as destination
// repl_pfx - prefix name of the current element
// repl_scx - prefix name of wrapped scenario
// repl_csr - CSR instruction [csrrc | csrrs | csrrw]
// repl_reg - register name
// repl_var - variable name
#define CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS_EXTRA(repl_pfx, repl_scx, repl_csr, repl_reg, repl_var) \
        CREATE_SCENARIO_WRAPPED_I_CONTROL_REGISTERS(repl_pfx, repl_scx, reg, repl_csr, reg0, repl_reg, regs, regs_unknown_0, repl_var)

//----------------------------------------------------------------------------------------------------------

// renew element statement which handling randomized value for immediate operand
// repl_typ - type of instruction [imm]
// repl_csr - CSR instruction [csrrci | csrrsi | csrrwi]
// repl_dst - destination operand [reg0 | regs]
// repl_reg - register name
// repl_src - source operand [imm5]
// repl_itm - intermediate hold ["x0" | regs_unknown_0]
// repl_var - variable name
// ... - (variadic argument) for instruction (depends on instruction) with mask symbol definition
#define CHANGE_ELEMENT_I_CONTROL_REGISTERS(repl_typ, repl_csr, repl_dst, repl_reg, repl_src, repl_itm, repl_var, ...) \
element i_control_registers_##repl_typ##__opc_##repl_csr##__##repl_dst##__csr_##repl_reg##__##repl_src##__ \
{ \
    override assembly { #repl_csr " " repl_itm ", " #repl_reg ", " repl_var __VA_ARGS__ }; \
}

// renew elements use randomized value for immediate operand
// repl_csr - CSR instruction [csrrci | csrrsi | csrrwi]
// repl_reg - register name
// repl_var - variable name
// ... - (variadic argument) for instruction (depends on instruction) with mask symbol definition
#define CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5(repl_csr, repl_reg, repl_var, ...) \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS(imm, repl_csr, regs, repl_reg, imm5, regs_unknown_0, repl_var, __VA_ARGS__); \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS(imm, repl_csr, reg0, repl_reg, imm5, "x0", repl_var, __VA_ARGS__)

// renew elements use randomized value for immediate operand (exactly specified instructions)
// repl_reg - register name
// repl_var - variable name
#define CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_FIX(repl_reg, repl_var) \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5(csrrci, repl_reg, repl_var); \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5(csrrsi, repl_reg, repl_var); \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5(csrrwi, repl_reg, repl_var)

//----------------------------------------------------------------------------------------------------------

// renew elements for clear and set CSR use with immediate operand TUNE variable
// repl_reg - register name
// repl_var - variable name
#define CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_TUNEZERO(repl_reg, repl_var) \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5(csrrci, repl_reg, repl_var); \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5(csrrsi, repl_reg, repl_var)

// renew elements for clear and set CSR use with immediate operand ONLY ZERO value!
// repl_reg - register name
#define CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_ONLYZERO(repl_reg) \
        CHANGE_ELEMENT_I_CONTROL_REGISTERS_IMM5_TUNEZERO(repl_reg, uimm_5_0_onlyzero)

// renew elements for clear and set CSR use with immediate operand NONE ZERO value!
