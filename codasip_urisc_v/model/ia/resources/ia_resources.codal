#include "config.hcodal"

register bit[INSTR_W] r_instr_fetch;
register bit[1] r_illegal_instr, r_unknown_instr;
register bit[1] r_fetch_fault;
register bit[1] r_pf_mem_error;
register bit[1] r_minstret_written;
register bit[1] r_fetch_hresp, r_ldst_hresp;
