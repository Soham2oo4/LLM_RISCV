#include "config.hcodal"
#include "common.hcodal"

event reset
{
    semantics
    {
        // Reset PC to a value read from a dedicated port at boot time (after reset)
        r_PC = p_boot_addr;
        r_syscall_addr = p_boot_addr + 0x10;

    };
};

start start_base
{
    roots = { isa };
    emulations = { emuls };
};

set emuls = e_movi32;

#if OPTION_XLEN == 64
set emuls += e_movi32_32, e_zext, e_trunc;
#endif

event main
{
    use isa;
    use resolve_illegal_inst;
    semantics
    {
        r_mcycle_inhibit = r_csr_mcountinhibit[0..0];
        r_minstret_inhibit = r_csr_mcountinhibit[2..2];

        // Truncate LSBs from PC
        r_PC = r_PC[XLEN - 1 .. 2] :: (uint2)0;
        r_csr_mip = p_meip :: (uint3)0 :: p_mtip :: (uint3)0 :: p_msip ::(uint3)0;

        if (((r_csr_mip & r_csr_mie) != 0) || p_nmi)
        {
            r_wfi = 0;
            traceprintf("Wake up\n");
        }

        // Wait-for-interrupt port
        p_wfi = r_wfi;

        if (!r_wfi || p_nmi)
        {
            take_int();

            // Global register for IA to track whether there was any fetch fault
            r_fetch_fault = 0;

            // Capture the control input ports value after reset
            if (r_reset_init)
            {
                r_reset_init = 0;
            }

            // Fetch instruction (r_fetch_fault indicates any errors)
            r_instr_fetch = fetch_instr(r_PC);

            if (!r_mcycle_inhibit)
            {
                r_csr_mcycle += 1;
            }

            r_illegal_instr = 0;
            r_pf_mem_error = 0;

            if (!r_fetch_fault)
            {
                traceprintf("%d: %016x | %08x | ", codasip_get_clock_cycle(), r_PC, r_instr_fetch);
                codasip_disassembler(TRACE_LEVEL, r_instr_fetch, r_PC, "default", 37);
                traceprintf(" | ");

                r_PC += INSTR_LAU_SIZE;
            }

            r_minstret_written = 0;

            // Call decoder - execute instruction semantics
            isa(r_instr_fetch, r_unknown_instr);

            // Illegal instruction logic
            resolve_illegal_inst();

            // Clean hresp for PMP/TCM checks
            r_ldst_hresp = CP_AHB_OKAY;
            r_fetch_hresp = CP_AHB_OKAY;
        }
    };
};

event resolve_illegal_inst
{
    semantics
    {
        if (!r_fetch_fault)
        {
            traceprintf("\n");
        }

        if (r_illegal_instr | r_unknown_instr)
        {
            take_trap(ILLEGAL_INST, r_instr_fetch, DEC_PC);
        }
        else if (!r_wfi &&
            !r_minstret_inhibit &&
            !r_fetch_fault &&
            !r_minstret_written &&
            !r_pf_mem_error)
        {
            r_csr_minstret += 1;
        }
    };
};

