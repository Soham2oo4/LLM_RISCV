start start_base { roots = { isa }; };

event main
{
    // Pipeline stages
    use fe;
    use id;
    use ex;
    use plc.compute as plc_compute;
    use perf.compute as perf_compute;

    semantics
    {
        p_wfi = !r_wfi_ce;

        // Pipeline stages
        ex();
        id();
        fe();

        // Pipeline controller
        plc.s_flush_i = s_flush;
        plc.s_id_clear_i = s_id_clear;
        plc.s_ex_stall_i = s_ex_stall;
        plc.s_ex_clear_i = s_ex_clear;
        plc.s_ex1_stall_i = s_ex1_stall;
        plc.s_ex1_clear_i = s_ex1_clear;
        plc_compute();

        // Performance counters
#ifdef OPTION_OCD
        perf.s_inhibit_i = crf.s_perf_inhibit_o;
#endif
        perf.s_hpm_inhibit_i = crf.s_hpm_inhibit_o;
        perf.s_flush_i = s_flush;
        perf.s_csr_flush_i = s_perf_csr_flush;
        perf.s_exc_flush_i = s_perf_exc_flush;
        perf.s_int_flush_i = s_perf_int_flush;
        perf.s_branch_miss_i = s_perf_branch_miss;
        perf.s_data_stall_i = s_perf_data_stall;
#ifdef OPTION_EXTENSION_M
        perf.s_div_stall_i = s_perf_div_stall;
#endif
        perf.s_ifu_stall_i = s_perf_ifu_stall;
        perf.s_lsu_stall_i = s_perf_lsu_stall;
        perf.s_perf_we_i = s_perf_we;
        perf.s_perf_wdata_i  = s_perf_wdata;
        perf.s_perf_waddr_i  = s_perf_waddr;
        perf_compute();

        #pragma simulator
        {
            codasip_print(TRACE_LEVEL, "%04d: ", codasip_get_clock_cycle());
            codasip_print(TRACE_LEVEL, "%05x %c | ",
                npc.s_ifu_addr_o,
                ifu.s_ifu_busy_o ? 's' : ' ');
            codasip_print(PRINT_LVL_IFU, "%05x [%02b] (%08x) | ",
                ifu.s_data_addr_o,
                ifu.s_data_valid_o,
                ifu.s_data_o);
            codasip_print(PRINT_LVL_IFB, "%05x [%02b] (%08x) ",
                ifb.s_addr_o,
                ifb.s_valid_o,
                ifb.s_data_o);
            codasip_print(PRINT_LVL_IFB, " %c%c | ",
                ifb.s_empty_o ? 'e' : ' ',
                ifb.s_full_o ? 'f' : ' ');
            codasip_disassembler(TRACE_LEVEL, ifb.s_valid_o ? ifb.s_data_o : (uint32)NOP, (UXLEN_T)ifb.s_addr_o, "default", 37);
            codasip_print(TRACE_LEVEL, " | %08x %c         ",
                r_ex_instr_addr,
                r_ex_instr_valid ? 'v' : ' ');
            switch (r_ex_fu)
            {
                case FU_ALU: codasip_print(TRACE_LEVEL, "alu "); break;
                case FU_LSU: codasip_print(TRACE_LEVEL, "lsu "); break;
                case FU_BRU: codasip_print(TRACE_LEVEL, "bru "); break;
                case FU_DIV: codasip_print(TRACE_LEVEL, "div "); break;
                case FU_MUL: codasip_print(TRACE_LEVEL, "mul "); break;
                case FU_CSR: codasip_print(TRACE_LEVEL, "csr "); break;
                default: codasip_print(TRACE_LEVEL, " -  "); break;
            }
            switch (r_ex1_fu)
            {
                case FU_LSU: codasip_print(TRACE_LEVEL, "lsu | "); break;
                case FU_DIV: codasip_print(TRACE_LEVEL, "div | "); break;
                case FU_MUL: codasip_print(TRACE_LEVEL, "mul | "); break;
                default: codasip_print(TRACE_LEVEL, " -  | "); break;
            }

            if (s_rd0_write & s_rd0_we & s_rd0_addr != 0)
            {
                codasip_print(TRACE_LEVEL, "r%02d<-%08x ", s_rd0_addr, s_rd0_data);
            }
            else
            {
                codasip_print(TRACE_LEVEL, "              ");
            }

            if (s_rd1_write & s_rd1_we & s_rd1_addr != 0)
            {
                codasip_print(TRACE_LEVEL, "r%02d<-%08x", s_rd1_addr, s_rd1_data);
            }
            codasip_print(TRACE_LEVEL, "\n");
        }

        if (r_reset_init)
        {
            // Store syscall address - read the boot address right after reset & add an offset.
            r_syscall_addr = p_boot_addr + 0x10;
        }

        // Disable register r_reset_init after first cycle.
        r_reset_init = false;
    };
};
