#include "common.hcodal"

event halt
{
    semantics
    {
        #pragma simulator
        {
            UXLEN_T ret_val;
            int i;

            codasip_print(PERF_LEVEL, "\n------------ halt ------------\n");

            perf_dump();

            // Read return value from the return value register
            ret_val = rf_gpr[REG_RETVAL];

            codasip_print(PERF_LEVEL, "Return value = %d\n", ret_val);
            codasip_store_exit_code(ret_val);
        }
        codasip_halt();
    };
};
