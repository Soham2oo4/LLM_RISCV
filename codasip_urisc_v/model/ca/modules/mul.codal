/*
 * Multiplier Unit (MUL) implements a sign-extended multiplication of two operands, done in parallel over a single cycle.
 */

#ifdef OPTION_EXTENSION_M

#include "ca_defines.hcodal"

#define SIGN_BIT                    (OPTION_XLEN-1)..(OPTION_XLEN-1)

module mul
{
    // Inputs
    signal bit[FU_OP_W] s_op_i;
    signal bit[OPTION_XLEN] s_s1_data_i;
    signal bit[OPTION_XLEN] s_s2_data_i;

    // Outputs
    signal bit[OPTION_XLEN] s_rd_data_o;

    event compute
    {
        semantics
        {
            // Prepare inputs
            uint1 s1_sign, s2_sign;
            int_<2 * OPTION_XLEN> result;
            uint1 is_valid;

            s1_sign = s_op_i == OP_MULH | s_op_i == OP_MULHSU;
            s2_sign = s_op_i == OP_MULH;

            result = (int_<2 * OPTION_XLEN>)(int_<OPTION_XLEN + 1>)((s1_sign & s_s1_data_i[SIGN_BIT]) :: s_s1_data_i)
                   * (int_<2 * OPTION_XLEN>)(int_<OPTION_XLEN + 1>)((s2_sign & s_s2_data_i[SIGN_BIT]) :: s_s2_data_i);

            // Set outputs
            switch (s_op_i)
            {
                case OP_MUL:
                    s_rd_data_o = result[OPTION_XLEN - 1 .. 0];
                    break;
                case OP_MULH:
                case OP_MULHSU:
                case OP_MULHU:
                    s_rd_data_o = result[2 * OPTION_XLEN - 1 .. OPTION_XLEN];
                    break;
#if OPTION_XLEN == 64
                case OP_MULW:
                    s_rd_data_o = (int_<OPTION_XLEN>)(int32)(result[31 .. 0]);
                    break;
#endif
                default:
                    s_rd_data_o = 0;
                    break;
            }
        };
    };
};

#endif // OPTION_EXTENSION_M
