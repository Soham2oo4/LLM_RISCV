/*
 * Hazard unit handles data hazards - it forwards results from EX stage to ID stage
 * and detects data hazards that cannot be forwarded.
 */

#include "ca_defines.hcodal"

module hazard
{
    // Inputs:
    // GPR
    signal bit[RF_ADDR_W]   s_rs_addr_i;
    signal bit[XLEN]        s_rs_data_i;
    // Forwarded results from EX:
    signal bit[RF_ADDR_W]   s_rd_addr_i;
    signal bit[XLEN]        s_rd_data_i;
    signal bit[1]           s_rd_we_i;
    // Data hazard detection - results that aren't forwarded
    signal bit[RF_ADDR_W]   s_p0_addr_i,
                            s_p1_addr_i;
    signal bit[1]           s_p0_we_i,
                            s_p1_we_i;

    // Outputs:
    signal bit[XLEN]        s_data_o;
    signal bit[1]           s_data_hazard_o;

    event compute
    {
        semantics
        {
            // Forward value from EX if there is a match
            s_data_o = (s_rs_addr_i == s_rd_addr_i & s_rd_we_i & s_rd_addr_i != 0)
                ? s_rd_data_i
                : s_rs_data_i;
            // Detect data hazards that cannot be solved by forwarding
            s_data_hazard_o =
                (s_rs_addr_i == s_p0_addr_i & s_p0_we_i & s_p0_addr_i != 0) |
                (s_rs_addr_i == s_p1_addr_i & s_p1_we_i & s_p1_addr_i != 0);
        };
    };
};
