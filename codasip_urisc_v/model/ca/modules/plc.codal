/*
 * PLC unit (pipeline controller) handles stalling and clearing of the pipeline
 */

// Pipeline controller
module plc
{
    // Inputs
    signal bit[1] s_flush_i;
    signal bit[1] s_id_clear_i;
    signal bit[1] s_ex_stall_i;
    signal bit[1] s_ex_clear_i;
    signal bit[1] s_ex1_stall_i;
    signal bit[1] s_ex1_clear_i;

    event compute
    {
        semantics
        {
            uint1 pipe_stall, pipe_clear;

            // There's mainly 1 pipeline controlled by the pipeline controller - between ID and EX stages.
            // - pipeline can be stalled only from back -> EX stage
            // - pipeline can be cleared from both back and front -> ID || EX stage

            pipe_stall = s_ex_stall_i;
            pipe_clear = s_id_clear_i | s_ex_clear_i | s_flush_i;

            if (pipe_clear)
            {
                pipe.EX.clear();
            }
            else if (pipe_stall)
            {
                pipe.EX.stall();
            }

            // "Virtual" EX1 stage handling
            if (s_ex1_clear_i)
            {
                pipe.EX1.clear();
            }
            else if (s_ex1_stall_i)
            {
                pipe.EX1.stall();
            }

            if (ifb.s_full_o | ifu.s_ifu_busy_o)
            {
                pipe.FE.stall();
            }
        };
    };
};
