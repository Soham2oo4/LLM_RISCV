/*
 * The on-chip debugger module (OCD) implements the main logic of the core related to entering, leaving
 * and executing operations in "debug mode". It also contains logic for accessing debug CSR registers
 * and logic responsible for interfacing with the debug module auto-generated by Codasip Studio.
 */

#ifdef OPTION_OCD

#include "ca_defines.hcodal"

#define DXLEN OPTION_XLEN

// debug mode states
enum dm_states : uint3
{
    USER_MODE,          // The core is running
    DEBUG_REQ,          // Request to halt the core - Halt request, SW/HW breakpoints
    DEBUG_AFTER_REQ,    // Enter to Debug mode after the instruction is executed
    DEBUG_MODE,         // The core is halted
    PROGBUF_MODE,       // Execution of the Program Buffer
};

#define DM_STATES_W bitsizeof (enum dm_states)

// debug mode dcsr.cause
enum : uint3
{
    DM_NONE,
    DM_SW_BREAK,
    DM_HW_BREAK,
    DM_HALT_REQ,
    DM_STEP,
};

module ocd
{
    // Inputs
    signal bit[XLEN] s_instr_addr_i;
    signal bit[1] s_instr_valid_i;
    // - from Debug Module
    signal bit[1] s_dm_active_i;
    signal bit[1] s_dm_halt_i;
    signal bit[1] s_dm_progbuf_en_i;
    // - from WB stage
    signal bit[1] s_exc_valid_i;
    signal bit[EXC_TYPE_W] s_exc_type_i;

    // Outputs
    // - to Debug module
    signal bit[1] s_hart_halted_o;
    signal bit[1] s_dm_progbuf_done_o;
    signal bit[1] s_dm_progbuf_exc_o;
    // - OCD
    signal bit[1] s_ocd_valid_o;
    signal bit[DXLEN] s_ocd_addr_o;
    signal bit[1] s_ocd_busy_o;
    signal bit[1] s_ocd_flush_o;
    signal bit[1] s_ocd_progbuf_mode_o;
    signal bit[1] s_ocd_debug_mode_req_o;
    signal bit[1] s_ocd_user_mod_req_o;
    signal bit[1] s_ocd_step_mode_o;

    // CSR
    signal bit[32] s_ocd_dcsr_o;
    signal bit[DXLEN] s_ocd_dpc_o;

    // Resources
    register bit[DM_STATES_W] r_debug_state;
    register bit[1] r_step_cause;

    event compute
    {
        semantics
        {
            uint1 state_user_mode;
            uint1 progbuf_done, progbuf_exc;
            uint1 hw_break_req, sw_break_req, step_req, halt_req;
            uint1 user_mode_req, debug_mode_req;
            uint_<DM_STATES_W> debug_state_next, user_mode_value, debug_req_value, debug_after_req_value;
            uint_<DM_STATES_W> debug_mode_value, progbuf_mode_value;
            uint1 debug_mode_before_req, debug_mode_after_req;
            uint3 cause;

            // User mode
            state_user_mode = (r_debug_state == USER_MODE);

            // Single step
            step_req = r_csr_dcsr[2..2] & s_instr_valid_i & state_user_mode;
            r_step_cause = (state_user_mode) ? step_req : r_step_cause;

            // HW break
            // Triggers do not fire while in Debug Mode.
            hw_break_req = s_exc_valid_i & (s_exc_type_i == TGM_DM);
            // SW break
            sw_break_req =
                s_exc_valid_i &
                (s_exc_type_i == BREAK) &
                r_csr_dcsr[15..15] // dcsr.ebreakm
                ;
            // Halt request
            halt_req = s_dm_halt_i & s_instr_valid_i;

            // Debug mode request
            debug_mode_before_req = (hw_break_req | sw_break_req | halt_req) & state_user_mode;
            debug_mode_after_req = (r_debug_state == DEBUG_AFTER_REQ) & s_instr_valid_i;
            debug_mode_req = (debug_mode_before_req | debug_mode_after_req) & s_dm_active_i;

            // Debug mode -> user mode
            user_mode_req = (r_debug_state == DEBUG_MODE) & !s_dm_halt_i;

            // Progbuf completed execution
            progbuf_done = s_exc_valid_i & s_instr_valid_i & (r_debug_state == PROGBUF_MODE);
            // If the last executed instruction wasn't ebreak, return progbuf exception
            progbuf_exc = progbuf_done & (s_exc_type_i != BREAK);

            // Print current state + Determine the next state
            switch (r_debug_state)
            {
                case USER_MODE:
                    debug_state_next =
                        (debug_mode_before_req) ? DEBUG_REQ :
                        (step_req) ? DEBUG_AFTER_REQ :
                        r_debug_state;
                    codasip_print(PRINT_LVL_JTAG, "USER_MODE | ");
                    break;
                case DEBUG_REQ:
                    debug_state_next =
                        (!s_dm_active_i) ? USER_MODE :
                        (s_dm_halt_i) ? DEBUG_MODE :
                        r_debug_state;
                    codasip_print(PRINT_LVL_JTAG, "DEBUG_REQ | ");
                    break;
                case DEBUG_AFTER_REQ:
                    debug_state_next =
                        (!s_dm_active_i) ? USER_MODE :
                        (debug_mode_req) ? DEBUG_REQ :
                        r_debug_state;
                    codasip_print(PRINT_LVL_JTAG, "DEBUG_AFTER_REQ | ");
                    break;
                case DEBUG_MODE:
                    debug_state_next =
                        (s_dm_progbuf_en_i) ? PROGBUF_MODE :
                        (!s_dm_halt_i) ? USER_MODE :
                        r_debug_state;
                    codasip_print(PRINT_LVL_JTAG, "DEBUG_MODE | ");
                    break;
                case PROGBUF_MODE:
                    debug_state_next =
                        (progbuf_done) ? DEBUG_MODE :
                        r_debug_state;
                    codasip_print(PRINT_LVL_JTAG, "PROGBUF_MODE | ");
                    break;
                default:
                    eprintf("Error: jtag_fsm - unknown state %d\n", r_debug_state);
                    break;
            }

            // State update
            r_debug_state = debug_state_next;

            // OCD outputs:

            // Update dcsr.cause field.
            // Respect the priorities of various causes, per RISC-V External Debug Support spec,
            // ver. 0.13.2, section 4.8.1.
            if (debug_mode_before_req)
            {
                cause =
                    hw_break_req ? DM_HW_BREAK :
                    sw_break_req ? DM_SW_BREAK :
                    s_dm_halt ? DM_HALT_REQ :
                    r_step_cause ? DM_STEP :
                    DM_NONE;
            }
            else if (debug_mode_after_req)
            {
                cause = r_step_cause ? DM_STEP : DM_NONE;
            }
            else
            {
                cause = (uint3) 0;
            }

            s_ocd_dcsr_o = r_csr_dcsr[31 .. 9] :: cause :: r_csr_dcsr[5 .. 2] :: PRV_M;
            s_ocd_dpc_o = s_instr_addr_i;

            s_ocd_valid_o = debug_mode_req | s_dm_progbuf_en_i | user_mode_req;
            s_ocd_addr_o =
                debug_mode_req ? s_instr_addr_i :
                s_dm_progbuf_en_i ? (uint_<DXLEN>)OPTION_PROGBUF_START :
                user_mode_req ? r_csr_dpc :
                0u;
            s_ocd_busy_o = (r_debug_state == DEBUG_REQ) | (r_debug_state == DEBUG_MODE);
            s_ocd_flush_o = debug_mode_req | s_dm_progbuf_en_i | user_mode_req | progbuf_done;
            s_ocd_debug_mode_req_o = debug_mode_req;
            s_ocd_user_mod_req_o = user_mode_req;
            s_ocd_progbuf_mode_o = (r_debug_state == PROGBUF_MODE);
            // DM
            s_hart_halted_o = (r_debug_state == DEBUG_REQ) | (r_debug_state == DEBUG_MODE);
            s_dm_progbuf_done_o = progbuf_done;
            s_dm_progbuf_exc_o = progbuf_exc;
        };
    };

    event ocd_output
    {
        semantics
        {
            s_ocd_step_mode_o = r_debug_state == DEBUG_AFTER_REQ;
        };
    };
};

#endif // ifdef OPTION_OCD
