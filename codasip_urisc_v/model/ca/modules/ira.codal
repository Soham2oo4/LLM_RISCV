/** Interrupt return address (IRA) component
 *
 * Purpose of this component is to keep track of retired instructions and to point at first
 * instruction that is yet to be executed in the program order.
 *
 * Address returned by this instruction should serve as a return point from interrupt routine
 * => address is to be written into mepc register.
 */

#include "ca_defines.hcodal"

module ira
{
    // Inputs
    signal bit [1] s_ex0_retired_i;
    signal bit [ADDR_W] s_ex0_instr_addr_i;
    signal bit [1] s_ex0_is_branch_i;
    signal bit [ADDR_W] s_ex0_branch_target_i;
    signal bit [1] s_ex0_is_csr_i;
    signal bit [ADDR_W] s_ex0_csr_addr_i;
    signal bit [1] s_ex1_retired_i;
    signal bit [ADDR_W] s_ex1_instr_addr_i;
#ifdef OPTION_OCD
    signal bit [ADDR_W] s_ocd_addr_i;
    signal bit [1] s_ocd_valid_i;
    signal bit [1] s_ocd_stop_count_i;
#endif

    // Outputs
    signal bit [ADDR_W] s_int_addr_o;

    // Internal
    register bit [ADDR_W] r_return_address;

    event outputs
    {
        semantics
        {
            s_int_addr_o = r_return_address;
        };
    };

    event update
    {
        semantics
        {
            uint_<ADDR_W> addr, addr_0, addr_1;

            addr_0 = s_ex0_instr_addr_i + (uint3)INSTR_LAU_SIZE;
            addr_1 = s_ex1_instr_addr_i + (uint3)INSTR_LAU_SIZE;

#ifdef OPTION_OCD
            if (s_ocd_valid_i)
            {
                addr = s_ocd_addr_i;
            }
            else
#endif
            if (s_ex0_retired_i)
            {
                addr =
                    s_ex0_is_csr_i ? s_ex0_csr_addr_i :
                    s_ex0_is_branch_i ? s_ex0_branch_target_i :
                    addr_0;
            }
            else
            {
                addr = addr_1;
            }

            if ((s_ex0_retired_i | s_ex1_retired_i)
#ifdef OPTION_OCD
                & ~s_ocd_stop_count_i | s_ocd_valid_i
#endif
                )
            {
                r_return_address = addr;
            }
        };
    };
};
