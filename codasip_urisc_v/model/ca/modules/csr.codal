/*
 * CSR is a combinational unit that processes control signals for control and status register file unit (CRF).
 */

#include "common.hcodal"
#include "ca_defines.hcodal"

module csr
{
    // Inputs
    signal bit[FU_OP_W]     s_op_i;
    signal bit[12]          s_csr_addr_i;
    signal bit[RF_ADDR_W]   s_csr_s1_addr_i;
    signal bit[FU_SOURCE_W] s_csr_s1_source_i;
    signal bit[OPTION_XLEN] s_csr_wdata_i;

    // Outputs
    signal bit[1]           s_csr_valid_o;
    signal bit[12]          s_csr_addr_o;
    signal bit[OPTION_XLEN] s_csr_wdata_o;
    signal bit[1]           s_csr_re_o;
    signal bit[1]           s_csr_we_o;
    signal bit[1]           s_csr_rd_we_o;

    event compute
    {
        semantics
        {
            uint1 csr_read, csr_write;

            // Read CSR if the addr is not 0
            csr_read = s_csr_addr_i != 0;

            // Write the CSR only if the source is not x0 or uimm != 0 for CSRRS[I] ot CSRRC[I].
            // See the "Table 9.1" in Chapter 9 (Zics) of the RISC-V ISA spec (Unprivileged ISA, V20191213).
            csr_write = (s_op_i == OP_CSRRW) |
                ((s_op_i == OP_CSRRS | s_op_i == OP_CSRRC) &
                // For CSRRS or CSRRC
                (s_csr_s1_source_i == FU_OP_REG & s_csr_s1_addr_i != 0) |
                // For CSRRSI or CSRRCI
                (s_csr_s1_source_i == FU_OP_IMM & s_csr_wdata_i != 0));

            // Set outputs
            if (s_op_i >= OP_CSRRW && s_op_i <= OP_WFI)
            {
                s_csr_addr_o = s_csr_addr_i;
                s_csr_wdata_o = s_csr_wdata_i;
                s_csr_re_o = csr_read;
                s_csr_we_o = csr_write;
                s_csr_rd_we_o = csr_read & (s_op_i == OP_CSRRW || s_op_i == OP_CSRRS || s_op_i == OP_CSRRC);
                s_csr_valid_o = true;
            }
            else
            {
                s_csr_addr_o = 0;
                s_csr_wdata_o = 0;
                s_csr_re_o = false;
                s_csr_we_o = false;
                s_csr_rd_we_o = false;
                s_csr_valid_o = false;
            }
        };
    };
};
