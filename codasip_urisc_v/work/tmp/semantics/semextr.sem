/// c_addi_lo(opc = opc_addi, dst, src, imm)
instruction c_addi_lo__opc_addi__regs__regs__
{
    operands { reg_0 = regop(regs), reg_1 = regop(regs), imm_2 = immop("MI3immIH1_10start_base1_9c_addi_lo") };
    assembly { "add" reg_0~"," reg_1~"," "%lo(" imm_2 ")" };
    binary { bit[32] };
    semantics
    {
    };
    alias = COMPILER;
    element_tree = "el:c_addi_lo(el:opc_addi, el:regs, el:regs)";
    slots = {{0}};
};

