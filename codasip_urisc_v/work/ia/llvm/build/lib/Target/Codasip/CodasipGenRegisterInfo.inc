static inline unsigned regsAltOrderSelect(const MachineFunction &MF) { if(true) return 1; else  return 0;}

static ArrayRef<MCPhysReg> regsGetRawAllocationOrder(const MachineFunction &MF) {
  static const MCPhysReg AltOrder1[] = {  Codasip::rf_gpr_10,  Codasip::rf_gpr_11,  Codasip::rf_gpr_12,  Codasip::rf_gpr_13,  Codasip::rf_gpr_14,  Codasip::rf_gpr_15,  Codasip::rf_gpr_16,  Codasip::rf_gpr_17,  Codasip::rf_gpr_5,  Codasip::rf_gpr_6,  Codasip::rf_gpr_7,  Codasip::rf_gpr_28,  Codasip::rf_gpr_29,  Codasip::rf_gpr_30,  Codasip::rf_gpr_31,  Codasip::rf_gpr_8,  Codasip::rf_gpr_9,  Codasip::rf_gpr_18,  Codasip::rf_gpr_19,  Codasip::rf_gpr_20,  Codasip::rf_gpr_21,  Codasip::rf_gpr_22,  Codasip::rf_gpr_23,  Codasip::rf_gpr_24,  Codasip::rf_gpr_25,  Codasip::rf_gpr_26,  Codasip::rf_gpr_27,  Codasip::rf_gpr_1,  Codasip::rf_gpr_3,  Codasip::rf_gpr_4 };
  const MCRegisterClass &MCR = CodasipMCRegisterClasses[Codasip::regsRegClassID];
  const ArrayRef<MCPhysReg> Order[] = {
    makeArrayRef(MCR.begin(), MCR.getNumRegs()),
    makeArrayRef(AltOrder1),
    ArrayRef<MCPhysReg>()
  };
  const unsigned Select = regsAltOrderSelect(MF);
  assert(Select < 3);
  return Order[Select];
}

