    // i_load__opc_loadb__regs__simm12_simple__regs__, i_load__opc_loadbu__re...
    O << " ( ";
    printOperand(MI, 1, O);
    O << " )";
    return;
    break;
  }


  // Fragment 4 encoded into 2 bits for 4 unique commands.
  switch ((Bits >> 28) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // i_ori_emulation_alias__regs__regs__simm12_lo__, i_ori_emulation_alias_...
    O << " ) & 0xfff";
    return;
    break;
  case 1:
    // i_ori_emulation_alias__regs__regs__simm12_simple__, i_addi_alias__regs...
    printOperand(MI, 2, O);
    break;
  case 2:
    // i_addi_alias__regs__regs__simm12_lo__, i_addi_alias__regs__regs__simm1...
    O << " )";
    return;
    break;
  case 3:
    // i_comp_3reg__opc_add__regs__regs__regs__, i_comp_3reg__opc_and__regs__...
    printOperand(MI, 1, O);
    return;
    break;
  }


  // Fragment 5 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 30) & 1) {
    // i_addi_alias__regs__regs__simm12_simple__, i_andi_alias__regs__regs__s...
    return;
  } else {
    // i_ori_emulation_alias__regs__regs__simm12_simple__
    O << " & 0xfff";
    return;
  }

}


